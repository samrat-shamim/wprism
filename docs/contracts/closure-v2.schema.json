{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duo.invalid/contracts/closure-v2.schema.json",
  "title": "Duo certification closure v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "candidate_commit", "runtime_payloads", "declaration_payloads",
    "build_definition", "test_plan", "harness", "oracles", "helpers",
    "toolchain", "platform", "providers", "environment", "run_receipts"
  ],
  "properties": {
    "format": {"const": "duo-certification-closure/v2"},
    "candidate_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "runtime_payloads": {"$ref": "#/$defs/digestMap"},
    "declaration_payloads": {"$ref": "#/$defs/digestMap"},
    "build_definition": {"$ref": "#/$defs/digest"},
    "test_plan": {"$ref": "#/$defs/digest"},
    "harness": {"$ref": "#/$defs/digestMap"},
    "oracles": {"$ref": "#/$defs/digestMap"},
    "helpers": {"$ref": "#/$defs/digestMap"},
    "toolchain": {"$ref": "evidence-identity.schema.json"},
    "platform": {"$ref": "evidence-identity.schema.json"},
    "providers": {"$ref": "evidence-identity.schema.json"},
    "environment": {"$ref": "evidence-identity.schema.json"},
    "run_receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "digestMap": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/digest"}}
  }
}
