#!/usr/bin/env php
<?php
declare(strict_types=1);

use Duo\Cloud\CanonicalJson;
use Duo\Cloud\FirewallClientConfig;
use Duo\Cloud\HostAuthorityBusy;
use Duo\Cloud\NativeContainerArgvProcessRunner;

require_once dirname(__DIR__) . '/runtime/FirewallClientConfig.php';
require_once dirname(__DIR__) . '/src/ContainerWorkloadRuntime.php';
require_once dirname(__DIR__) . '/src/HostAuthorityBusy.php';

try {
    $arguments = $_SERVER['argv'] ?? null;
    if (!is_array($arguments) || !array_is_list($arguments)) {
        throw new RuntimeException('storage client arguments are unavailable');
    }
    array_shift($arguments);
    $action = $arguments[0] ?? null;
    if (!is_string($action) || !in_array($action, [
        'bind', 'fleet-preflight', 'inspect', 'preflight',
        'proof-bind', 'proof-inspect', 'proof-unbind', 'unbind',
    ], true)) {
        throw new RuntimeException('storage client action is invalid');
    }
    foreach ($arguments as $argument) {
        if (!is_string($argument) || $argument === '' || str_contains($argument, "\0")) {
            throw new RuntimeException('storage client argument is invalid');
        }
    }
    // The privilege bridge schema is intentionally shared with the firewall
    // client: it pins sudo, the absolute interpreter, and the complete
    // root-executed PHP closure before crossing the privilege boundary.
    $config = FirewallClientConfig::loadInstalled(
        '/var/lib/duo-cloud/config/storage-client.json',
        '/var/lib/duo-cloud/config/storage-client.sha256'
    );
    $runner = new NativeContainerArgvProcessRunner($config->timeout(), null, false);
    $result = $runner->run(array_merge([
        $config->sudo(), '--non-interactive', '--', $config->authority(),
    ], $arguments));
    if (HostAuthorityBusy::matchesProcessResult(
        $result,
        HostAuthorityBusy::STORAGE_AUTHORITY_STDERR
    )) {
        fwrite(STDERR, HostAuthorityBusy::STORAGE_CLIENT_STDERR);
        exit(HostAuthorityBusy::EXIT_STATUS);
    }
    if ($result['exit'] !== 0 || $result['stderr'] !== ''
        || strlen($result['stdout']) > 1048576 || !str_ends_with($result['stdout'], "\n")) {
        throw new RuntimeException('storage authority refused');
    }
    $document = CanonicalJson::decodeObject($result['stdout'], 1048576);
    if ($result['stdout'] !== CanonicalJson::encode($document) . "\n") {
        throw new RuntimeException('storage authority response is not canonical');
    }
    fwrite(STDOUT, $result['stdout']);
} catch (Throwable) {
    fwrite(STDERR, "duo-cloud-storage-client: refused\n");
    exit(70);
}
