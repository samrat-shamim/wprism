#!/usr/bin/env php
<?php
declare(strict_types=1);

use Duo\Cloud\CanonicalJson;
use Duo\Cloud\GitCredentialProvider;

require_once dirname(__DIR__) . '/runtime/GitCredentialProvider.php';

const DUO_GIT_CREDENTIAL_DESCRIPTOR = '/var/lib/duo-cloud/config/repository-credential.json';
const DUO_GIT_CREDENTIAL_PIN = '/var/lib/duo-cloud/config/repository-credential.sha256';

try {
    $arguments = $_SERVER['argv'] ?? null;
    if (!is_array($arguments) || !array_is_list($arguments)) {
        throw new RuntimeException('credential helper arguments are unavailable');
    }
    foreach ($arguments as $argument) {
        if (!is_string($argument)) {
            throw new RuntimeException('credential helper argument is invalid');
        }
    }
    $provider = GitCredentialProvider::load(
        DUO_GIT_CREDENTIAL_DESCRIPTOR,
        DUO_GIT_CREDENTIAL_PIN
    );
    if (count($arguments) === 2 && $arguments[1] === 'verify') {
        fwrite(STDOUT, CanonicalJson::encode($provider->status()) . "\n");
        exit(0);
    }
    if (count($arguments) !== 2 || !in_array($arguments[1], ['get', 'store', 'erase'], true)) {
        throw new RuntimeException('credential helper arguments are invalid');
    }
    $input = stream_get_contents(STDIN, 16385);
    if (!is_string($input) || strlen($input) > 16384) {
        throw new RuntimeException('credential helper input is invalid');
    }
    fwrite(STDOUT, $provider->handle($arguments[1], $input));
} catch (Throwable) {
    // Git sees only success or refusal. Provider paths, pins, and secret bytes
    // never enter stderr, argv, the environment, or runtime evidence.
    exit(1);
}
