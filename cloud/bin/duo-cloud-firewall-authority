#!/usr/local/bin/php
<?php
declare(strict_types=1);

use Duo\Cloud\CanonicalJson;
use Duo\Cloud\FirewallAuthorityArguments;
use Duo\Cloud\HostFirewallAuthority;
use Duo\Cloud\HostFirewallConfig;
use Duo\Cloud\HostAuthorityBusy;
use Duo\Cloud\NativeContainerArgvProcessRunner;

require_once dirname(__DIR__) . '/runtime/HostFirewallAuthority.php';
require_once dirname(__DIR__) . '/runtime/HostFirewallConfig.php';
require_once dirname(__DIR__) . '/runtime/FirewallAuthorityArguments.php';
require_once dirname(__DIR__) . '/src/HostAuthorityBusy.php';

try {
    $arguments = $_SERVER['argv'] ?? null;
    if (!is_array($arguments) || !array_is_list($arguments)) {
        throw new RuntimeException('firewall arguments are unavailable');
    }
    array_shift($arguments);
    $request = FirewallAuthorityArguments::parse($arguments);
    $action = $request['action'];
    $options = $request['options'];
    $configPath = '/var/lib/duo-cloud/config/firewall-authority.json';
    $pinPath = '/var/lib/duo-cloud/config/firewall-authority.sha256';
    $config = HostFirewallConfig::loadInstalled($configPath, $pinPath);
    $sudoUid = getenv('SUDO_UID');
    if (!function_exists('posix_geteuid') || posix_geteuid() !== 0
        || !is_string($sudoUid) || preg_match('/\A[1-9][0-9]{0,9}\z/D', $sudoUid) !== 1) {
        throw new RuntimeException('firewall authority requires an authenticated sudo caller');
    }
    $authority = new HostFirewallAuthority(
        new NativeContainerArgvProcessRunner($config->timeout(), null, false),
        $config->containerEngine(),
        $config->nft(),
        $config->ip(),
        $config->stateRoot(),
        $config->principals(),
        (int) $sudoUid
    );
    $result = match ($action) {
        'bind' => $authority->bind([
            'bridge_name' => $options['bridge-name'],
            'configuration_sha256' => $options['config-sha256'],
            'gateway' => $options['gateway'],
            'network_id' => $options['network-id'],
            'network_name' => $options['network-name'],
            'subnet' => $options['subnet'],
        ]),
        'inspect' => $authority->inspect($options['config-sha256'], $options['network-name']),
        'preflight' => $authority->preflight(),
        'reconcile' => $authority->reconcile(),
        'unbind' => $authority->unbind($options['config-sha256'], $options['network-name']),
        'worker-preflight' => $authority->workerPreflight($options['config-sha256']),
    };
    fwrite(STDOUT, CanonicalJson::encode($result) . "\n");
} catch (HostAuthorityBusy) {
    fwrite(STDERR, HostAuthorityBusy::FIREWALL_AUTHORITY_STDERR);
    exit(HostAuthorityBusy::EXIT_STATUS);
} catch (Throwable) {
    fwrite(STDERR, "duo-cloud-firewall-authority: refused\n");
    exit(70);
}
