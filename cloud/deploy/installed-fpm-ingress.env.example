# Root-owned systemd EnvironmentFile; contains file identities, never secret bytes.
DUO_CLOUD_INSTALLED_FPM_CONFIGURATION_FILE=/var/lib/duo-cloud/config/installed-fpm-ingress.json
DUO_CLOUD_INSTALLED_FPM_CONFIGURATION_SHA256=REPLACE_WITH_LOWERCASE_SHA256
DUO_CLOUD_INSTALLED_FPM_HOST_PREFLIGHT_ROOT=/var/lib/duo-cloud/host-preflight
