# Service-owned systemd EnvironmentFile rendered once per exact worker configuration.
DUO_CLOUD_PROOF_CONFIGURATION_FILE=/var/lib/duo-cloud/config/workers/REPLACE_WORKER.json
DUO_CLOUD_PROOF_CONFIGURATION_SHA256=REPLACE_WORKER_CONFIGURATION_SHA256
DUO_CLOUD_PROOF_HOST_PREFLIGHT_ROOT=/var/lib/duo-cloud/host-preflight
DUO_CLOUD_PROOF_SYNTHETIC_ROTATION_CONFIGURATION_SHA256=REPLACE_DOMAIN_SEPARATED_SYNTHETIC_ROTATION_SHA256
