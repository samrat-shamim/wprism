parameters:
    level: max
    paths:
        - sandbox/catalog/fragments/engineering-platform
    scanFiles:
        - cli/src/ArtifactTrust/ArtifactTrustVerifier.php
        - cli/src/HostContracts/ReleaseSelection.php
    excludePaths:
        analyse:
            - sandbox/catalog/fragments/engineering-platform/generated (?)
    tmpDir: artifacts/phpstan
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: true
