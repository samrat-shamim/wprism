{
  "name": "users-customers-import-export-for-wp-woocommerce",
  "spec_version": 3,
  "plugin": "users-customers-import-export-for-wp-woocommerce/users-customers-import-export-for-wp-woocommerce.php",
  "version_range": {
    "min": "2.7.5",
    "max": "2.7.6"
  },
  "engine_features": [
    "column-field-labels/v1",
    "column-field-template-requirements/v1",
    "column-field-templates/v1",
    "column-input-files/v1",
    "column-record-fields/v1",
    "column-value-cases/v1",
    "json-column-codecs/v1",
    "object-record-fields/v1",
    "scalar-option-constraints/v1",
    "spec-window/v1",
    "table-row-scope-sets/v1",
    "table-row-scopes/v1",
    "typed-column-codecs/v1",
    "typed-column-values/v1"
  ],
  "option_autoload": "preserve",
  "deletions": {
    "table:wt_iew_mapping_template": {
      "cascades": [],
      "guards": [],
      "executable_owner_boundary": "all_active_owners",
      "executable_owner_identities": {
        "plugin:users-customers-import-export-for-wp-woocommerce/users-customers-import-export-for-wp-woocommerce.php": [
          {
            "format": "wprism-executable-tree/v1",
            "root": "plugins/users-customers-import-export-for-wp-woocommerce",
            "sha256": "5aa9ac5e9fc7dc10a3ad38ea3ce324592b952937d56c171e8129879fea888a2a"
          }
        ]
      }
    }
  },
  "options": {
    "wt_iew_advanced_settings": {
      "class": "env",
      "required": false,
      "sub_keys": {
        "wt_iew_maximum_execution_time": {
          "class": "authored",
          "lint_ok": true,
          "value_constraint": {
            "type": "integer"
          },
          "note": "admin/modules/import/import.php:124-133 and helpers/class-wt-security-helper.php:72-74 store an integer; the plugin bootstrap passes it to set_time_limit (main file:93-97). Nonnumeric text can fatal. Native Save admits signed integers, so no unproven range is imposed."
        },
        "wt_iew_enable_import_log": {
          "class": "authored",
          "lint_ok": true,
          "value_constraint": {
            "enum": [
              0,
              1
            ]
          },
          "note": "admin/modules/import/import.php:135-145: authored logging toggle; generated logs and imported records remain runtime."
        },
        "wt_iew_default_import_method": {
          "class": "authored",
          "lint_ok": true,
          "value_constraint": {
            "enum": [
              "new",
              "quick",
              "template"
            ]
          },
          "note": "admin/modules/import/import.php:147-156: default wizard method; native source quick and target template were Saved and reopened."
        },
        "wt_iew_default_import_batch": {
          "class": "authored",
          "lint_ok": true,
          "value_constraint": {
            "type": "integer",
            "minimum": 1
          },
          "note": "admin/modules/import/import.php:155-163 declares min 1; import.php:991-1018 passes this default to class-csvreader.php:195-250. Zero misses the reader break after row_count increments and consumes the remaining file without batching."
        },
        "wt_iew_default_export_method": {
          "class": "authored",
          "lint_ok": true,
          "value_constraint": {
            "enum": [
              "new",
              "quick",
              "template"
            ]
          },
          "note": "admin/modules/export/export.php:132-145: default export wizard method; source and target native Saves diverged."
        },
        "wt_iew_default_export_batch": {
          "class": "authored",
          "lint_ok": true,
          "value_constraint": {
            "type": "integer",
            "minimum": 1
          },
          "note": "admin/modules/export/export.php:155-164 declares min 1. export.php:631-645 and 917-922 preserve a zero default, so offset + batch_count at 702 cannot progress through a nonempty export. No unproven maximum is imposed."
        },
        "wt_iew_enable_history_auto_delete": {
          "class": "authored",
          "lint_ok": true,
          "value_constraint": {
            "enum": [
              0,
              1
            ]
          },
          "note": "admin/modules/history/history.php:242-253: authored retention toggle. Applying configuration must not replay after_advanced_setting_update or purge operational history."
        },
        "wt_iew_auto_delete_history_count": {
          "class": "authored",
          "lint_ok": true,
          "value_constraint": {
            "type": "integer",
            "minimum": 0
          },
          "note": "admin/modules/history/history.php:257-272: authored history retention limit, not a history row ID."
        },
        "wt_iew_include_bom": {
          "class": "authored",
          "lint_ok": true,
          "value_constraint": {
            "enum": [
              0,
              1,
              "1"
            ]
          },
          "note": "admin/modules/export/export.php:145-153 declares default integer 1; native Save stores checked string 1 and unchecked integer 0. Preserve these exact scalar spellings instead of coercing them."
        }
      },
      "note": "Shared settings container: only these nine native user-importer controls are owned. Other module keys remain target-local and must survive partial Apply."
    },
    "wt_iew_admin_modules": {
      "class": "runtime",
      "note": "admin/class-wt-import-export-for-woo-admin.php:425-448: active module initialization flags, not portable settings."
    },
    "wt_u_iew_is_active": {
      "class": "runtime"
    },
    "wt_u_iew_basic_json_migration_complete": {
      "class": "runtime"
    }
  },
  "notes": [
    "Official 2.7.5 admin/class-wt-import-export-for-woo-admin.php:395-418 deletes one mapping-template row without hooks, cascades or cache writes. Saved copies and history retain independent form snapshots; selected_template is a local wizard cursor, not a retained dependency. Only declared user/import and user/export rows are deletable. The all-active-owner boundary requires the exact reviewed Importer tree and independent site agreements, and refuses additional plugin owners without their own agreeing declaration.",
    "Experimental 2.7.5 settings and saved user import/export template capsule. Native settings and export evidence are retained; broader production qualification remains separate.",
    "admin/modules/export/classes/class-export-ajax.php:391-400 uses the saved selected_template only for history preselection. Normal reopen selects the requested row ID; export/assets/js/main.js:395 rebuilds this cursor from the current wizard selection. Shared record_fields retains method_export and mapping_enabled_fields; the saved cursor is regenerated UI state.",
    "Saved mapping_fields contains field-code to [label,integer-enabled] definitions; mapping_selected_fields supplies backend CSV headers. Exact field-label declarations preserve these maps without a column-wide privacy exception. Selected users use strict login bindings and native string IDs.",
    "Import mappings transport field expressions without CSV contents or customer records. The native free-plugin local-file mode requires an independently provisioned CSV under webtoffee_import; missing files block selected Apply. Generated exports/logs, imported users, customer records and history remain local.",
    "The native settings Save invokes wt_iew_after_advanced_setting_update_basic, whose history listener can delete files and records. WPrism materializes configuration without replaying this operational action.",
    "Import import.php:194-272 exposes local input and delimiter controls. class-import-ajax.php:66-84 and 692-704 reopen using the requested template row; the saved selected_template cursor is regenerated. Typed object projection retains method, delimiter and local-input fields while exact input_file semantics preserve the functional dependency."
  ],
  "tables": {
    "wt_iew_action_history": {
      "class": "runtime",
      "note": "Completed and in-progress import/export jobs, counters and file names stay local. Native history retention owns their deletion."
    },
    "wt_iew_mapping_template": {
      "class": "authored_snapshot",
      "pk": "id",
      "id_kind": "iew_template",
      "slug_column": "name",
      "identity": {
        "mode": "natural_key",
        "columns": [
          "template_type",
          "item_type",
          "name"
        ]
      },
      "row_scope": {
        "item_type": "user",
        "template_type": [
          "export",
          "import"
        ]
      },
      "columns": {
        "template_type": {
          "class": "authored"
        },
        "item_type": {
          "class": "authored"
        },
        "name": {
          "class": "authored"
        },
        "data": {
          "class": "authored"
        }
      },
      "refs": [],
      "note": "Native do_save_template checks (template_type,item_type,name) and stores JSON in data. Exact user/import and user/export rows are owned through separate value cases; non-user and case-variant rows remain local."
    }
  },
  "column_codecs": {
    "wt_iew_mapping_template": {
      "data": {
        "container": "json",
        "value_cases": {
          "column": "template_type",
          "cases": [
            {
              "equals": "export",
              "value": {
                "class": "authored",
                "object_fields": {
                  "post_type_form_data": {
                    "class": "authored",
                    "plain_data": true
                  },
                  "method_export_form_data": {
                    "class": "authored",
                    "plain_data": true,
                    "record_fields": {
                      "container": "object",
                      "fields": [
                        "method_export",
                        "mapping_enabled_fields"
                      ]
                    }
                  },
                  "filter_form_data": {
                    "class": "authored",
                    "object_fields": {
                      "wt_iew_limit": {
                        "class": "authored",
                        "plain_data": true
                      },
                      "wt_iew_offset": {
                        "class": "authored",
                        "plain_data": true
                      },
                      "wt_iew_roles": {
                        "class": "authored",
                        "plain_data": true
                      },
                      "wt_iew_sort_columns": {
                        "class": "authored",
                        "plain_data": true
                      },
                      "wt_iew_order_by": {
                        "class": "authored",
                        "plain_data": true
                      },
                      "wt_iew_email": {
                        "class": "authored",
                        "ref": "user[]",
                        "cast": "string",
                        "on_unmapped": "refuse"
                      },
                      "wt_iew_date_from": {
                        "class": "authored",
                        "plain_data": true
                      },
                      "wt_iew_date_to": {
                        "class": "authored",
                        "plain_data": true
                      }
                    }
                  },
                  "mapping_form_data": {
                    "class": "authored",
                    "object_fields": {
                      "mapping_fields": {
                        "class": "authored",
                        "field_labels": "label_enabled"
                      },
                      "mapping_enabled_fields": {
                        "class": "authored",
                        "plain_data": true
                      },
                      "mapping_selected_fields": {
                        "class": "authored",
                        "field_labels": "label"
                      }
                    }
                  },
                  "meta_step_form_data": {
                    "class": "authored",
                    "plain_data": true
                  },
                  "advanced_form_data": {
                    "class": "authored",
                    "plain_data": true
                  }
                }
              }
            },
            {
              "equals": "import",
              "value": {
                "class": "authored",
                "object_fields": {
                  "post_type_form_data": {
                    "class": "authored",
                    "object_fields": {
                      "item_type": {
                        "class": "authored",
                        "enum": [
                          "user"
                        ]
                      }
                    }
                  },
                  "method_import_form_data": {
                    "class": "authored",
                    "object_fields": {
                      "method_import": {
                        "class": "authored",
                        "enum": [
                          "new",
                          "quick",
                          "template"
                        ]
                      },
                      "wt_iew_file_from": {
                        "class": "authored",
                        "enum": [
                          "local"
                        ]
                      },
                      "wt_iew_local_file": {
                        "class": "authored",
                        "input_file": {
                          "directory": "webtoffee_import",
                          "extensions": [
                            "csv"
                          ]
                        }
                      },
                      "wt_iew_delimiter_preset": {
                        "class": "authored",
                        "plain_data": true
                      },
                      "wt_iew_delimiter": {
                        "class": "authored",
                        "plain_data": true
                      }
                    },
                    "record_fields": {
                      "container": "object",
                      "fields": [
                        "method_import",
                        "wt_iew_file_from",
                        "wt_iew_local_file",
                        "wt_iew_delimiter_preset",
                        "wt_iew_delimiter"
                      ]
                    }
                  },
                  "mapping_form_data": {
                    "class": "authored",
                    "object_fields": {
                      "mapping_fields": {
                        "class": "authored",
                        "field_templates": {
                          "format": "brace_enabled",
                          "required_enabled": ["user_pass"]
                        }
                      },
                      "mapping_selected_fields": {
                        "class": "authored",
                        "field_templates": {
                          "format": "brace",
                          "required_nonempty": ["user_pass"]
                        }
                      }
                    }
                  },
                  "meta_step_form_data": {
                    "class": "authored",
                    "object_fields": {
                      "mapping_fields": {
                        "class": "authored",
                        "field_templates": "brace_enabled"
                      },
                      "mapping_selected_fields": {
                        "class": "authored",
                        "field_templates": "brace"
                      }
                    }
                  },
                  "advanced_form_data": {
                    "class": "authored",
                    "plain_data": true
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
