{
  "manifest": "qi-blocks",
  "entry": {
    "mode": "agent-roundtrip",
    "pin": [
      "core",
      "qi-blocks"
    ],
    "plugins": [
      {
        "slug": "qi-blocks",
        "version": "1.5.2"
      }
    ],
    "post_types": [
      "post",
      "page",
      "attachment"
    ],
    "taxonomies": [
      "category",
      "post_tag"
    ],
    "disable_target_cron": true,
    "adopt_by_slug": [
      "terms",
      "posts"
    ]
  }
}
