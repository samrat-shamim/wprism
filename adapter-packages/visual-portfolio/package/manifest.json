{
  "name": "visual-portfolio",
  "spec_version": 3,
  "plugin": "visual-portfolio/class-visual-portfolio.php",
  "version_range": {"min": "3.8.1", "max": "3.8.2"},
  "engine_features": [
    "block-attribute-groups/v1", "block-attribute-values/v1", "block-value-contracts/v1", "encoded-text-values/v1",
    "manifest-provider-fresh-process/v1", "manifest-provider-runtime/v1", "post-meta-invalidation/v1",
    "provider-filesystem-file-snapshot/v1", "provider-native-option-inputs/v1",
    "provider-native-post-types/v1", "provider-physical-table-rows/v1",
    "spec-window/v1"
  ],
  "providers": [{
    "id": "visual-portfolio-settings", "source": "manifest", "version": "1.0.0",
    "plugin": "visual-portfolio/class-visual-portfolio.php",
    "capabilities": ["reconcile_settings"],
    "fresh_process_capabilities": ["reconcile_settings"],
    "requires": {
      "classes": ["Visual_Portfolio_Archive_Mapping", "Visual_Portfolio_Custom_Post_Type", "Visual_Portfolio_Settings", "WP_Rewrite"],
      "functions": ["did_action", "get_home_path", "is_blog_installed", "visual_portfolio", "wp_roles"]
    },
    "contracts": {"reconcile_settings": {
      "args": [], "scope": "site", "idempotent": true, "timeout_seconds": 600,
      "reads": ["table:options", "table:postmeta", "table:posts", "table:term_relationships", "table:term_taxonomy", "table:termmeta", "table:terms", "table:usermeta", "table:users"],
      "writes": ["table:options", "table:postmeta"],
      "scoped": {"operation_envelope": "wprism-scoped-effect-operation/v1", "receipt_projection": "handler", "reconcile": true}
    }}
  }],
  "actions": [{
    "kind": "provider", "provider": "visual-portfolio-settings", "capability": "reconcile_settings", "args": [],
    "effects": [
      {"id": "visual-portfolio-settings-options", "kind": "database", "mode": "restorable", "selector": {"scope": "database_checkpoint", "type": "table", "value": "options"}},
      {"id": "visual-portfolio-archive-markers", "kind": "database", "mode": "restorable", "selector": {"scope": "database_checkpoint", "type": "table", "value": "postmeta"}},
      {"id": "visual-portfolio-server-rules", "kind": "filesystem", "mode": "irreversible", "selector": {"scope": "external", "type": "provider_resource", "value": "visual-portfolio-settings:v1:wordpress-root-htaccess-and-web-config"}},
      {"id": "visual-portfolio-native-settings-hooks", "kind": "external", "mode": "irreversible", "selector": {"scope": "external", "type": "provider_resource", "value": "visual-portfolio-settings:v1:rewrite-meta-role-hooks-and-object-cache"}}
    ]
  }],
  "option_autoload": "preserve",
  "option_namespaces": [{"match": "^(?:_?vp_|vpf_|visual_portfolio_)"}],
  "options": {
    "_vp_add_archive_page": {"class": "runtime"},
    "_vp_trying_to_add_archive_page": {"class": "runtime"},
    "portfolio_permalinks": {
