        "category_base": {"class": "authored"},
        "tag_base": {"class": "authored"},
        "attribute_base": {"class": "authored"}
      }
    },
    "visual_portfolio_items_count_notice_state": {"class": "runtime"},
    "visual_portfolio_updated_caps": {"class": "runtime"},
    "vp_general": {
      "class": "env",
      "required": false,
      "closed_sub_keys": true,
      "sub_keys": {
        "register_portfolio_post_type": {"class": "authored"},
        "portfolio_archive_page": {"class": "authored", "ref": "post", "cast": "string"},
        "archive_page_items_per_page": {"class": "authored", "lint_ok": true},
        "filter_taxonomies": {"class": "authored"},
        "no_image": {"class": "authored", "ref": "post", "cast": "string"},
