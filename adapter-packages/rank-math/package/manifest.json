    "declaration_evidence": {
        "options.rank-math-options-general": {
            "evidence": [
                {
                    "locator": "Rank Math setup wizard and wp option get rank-math-options-general --format=json",
                    "observation": "The real wizard persisted the 47-key general settings object, including an environment URL at attachment_redirect_default and Unicode/delimiter-capable presentation strings; plain_data is required to tokenize every nested string leaf without treating module settings as secrets or ids.",
                    "source": "dogfood pair rmauthor, 2026-08-27, Rank Math SEO 1.0.277"
                }
            ]
        },
        "options.rank-math-options-titles": {
            "evidence": [
                {
                    "locator": "Rank Math setup wizard plus includes/admin/wizard/class-your-site.php:116-127",
                    "observation": "Exact 1.0.277.2 source reads five local WordPress ids from this object: homepage_facebook_image_id, knowledgegraph_logo_id and open_graph_image_id are attachment posts; local_seo_about_page and local_seo_contact_page are pages. All five require post identity rebinding while ordinary string leaves retain environment tokenization.",
                    "source": "dogfood pair rmauthor and exact 1.0.277 source"
                }
            ]
        },
        "options.rank_math_registration_skip": {
            "evidence": [
                {
                    "locator": "Rank Math registration skip UI, rank-math.php:291-299, and includes/admin/class-registration.php:25-45",
                    "observation": "The target exercise proved this is executable setup state, not an optional environment hint: without the source site's skip choice, Registration::$invalid makes Rank Math return before constructing its module manager, so redirections and every other selected module remain inert even though rank_math_modules was applied exactly.",
                    "source": "dogfood pair rmauthor, 2026-08-27, Rank Math SEO 1.0.277"
                }
            ]
        },
        "post_meta.rank_math_primary_*": {
            "evidence": [
                {
                    "locator": "POST /wp-json/rankmath/v1/updateMeta followed by raw wp_postmeta read",
                    "observation": "rank_math_primary_category stored the source category's local term id as the digit string '2'. A post with id 2 existed simultaneously, which exposed and now regresses the pending-queue ownership collision; the declaration is term + cast:string.",
                    "source": "dogfood pair rmauthor, 2026-08-27"
                }
            ]
        },
        "tables.rank_math_redirections": {
            "evidence": [
                {
                    "locator": "POST /wp-json/rankmath/v1/updateRedirection, SHOW COLUMNS, and two real HTTP requests",
                    "observation": "The native endpoint created one 302 rule with serialized sources and an authored destination; HTTP returned the exact Location twice while hits/last_accessed changed. Those counters are runtime, the rule fields are authored, and rank_math_redirections_cache is a rebuildable lookup invalidated by redirection_id.",
                    "source": "dogfood pair rmauthor, 2026-08-27, Rank Math SEO 1.0.277"
                }
            ]
        }
    },
    "engine_features": [
        "manifest-provider-runtime/v1",
        "post-kind-action-trigger/v1",
        "spec-window/v1",
        "structured-evidence/v1"
    ],
