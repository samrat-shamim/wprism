    "providers": [
        {
            "capabilities": [
                "prepare_schema",
                "rebuild_all_link_state",
                "rebuild_link_state"
            ],
            "contracts": {
                "prepare_schema": {
                    "args": [],
                    "idempotent": true,
                    "reads": [
                        "table:rank_math_internal_links",
                        "table:rank_math_internal_meta",
                        "table:rank_math_redirections",
                        "table:rank_math_redirections_cache"
                    ],
                    "scope": "site",
                    "timeout_seconds": 60,
                    "writes": [
                        "table:rank_math_internal_links",
                        "table:rank_math_internal_meta",
                        "table:rank_math_redirections",
                        "table:rank_math_redirections_cache"
                    ]
                },
                "rebuild_all_link_state": {
                    "args": [],
                    "idempotent": true,
                    "reads": [
                        "option:rank_math_modules",
                        "table:postmeta",
                        "table:posts",
                        "table:rank_math_internal_links",
                        "table:rank_math_internal_meta"
                    ],
                    "scope": "site",
                    "timeout_seconds": 600,
                    "writes": [
                        "table:postmeta",
                        "table:rank_math_internal_links",
                        "table:rank_math_internal_meta"
                    ]
                },
                "rebuild_link_state": {
                    "args": [],
                    "idempotent": true,
                    "reads": [
                        "entity:post",
                        "table:postmeta",
                        "table:posts",
                        "table:rank_math_internal_links",
                        "table:rank_math_internal_meta"
                    ],
                    "scope": "entity",
                    "timeout_seconds": 300,
                    "writes": [
                        "table:postmeta",
                        "table:rank_math_internal_links",
                        "table:rank_math_internal_meta"
                    ]
                }
            },
            "id": "rank-math-state",
            "plugin": "seo-by-rank-math/rank-math.php",
