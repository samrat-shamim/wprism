    spl_autoload_register(static function (string $class) use ($wprismAgentClassmap, $wprismAgentRoot): void {
        if (!isset($wprismAgentClassmap[$class])) {
            return;
        }
        $file = $wprismAgentRoot . '/' . $wprismAgentClassmap[$class];
        if (is_file($file)) {
            require_once $file;
        }
    });
}

