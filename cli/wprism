require __DIR__ . '/src/Adapter/AdapterBoundary.php';
require __DIR__ . '/src/Adapter/AdapterProposals.php';
// WP-5.6's discovery and distribution channel. After AdapterCertify because
// it installs the same two files that verb writes and verifies them through
// the same `AdapterCertification::verifyFile()`; it requires none of that
// class's code, so the ordering is about reading order, not linkage.
require __DIR__ . '/src/Adapter/AdapterDistribution.php';
