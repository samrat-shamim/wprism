/**
 * Additive classmap fallback for both trees (issue #3481, owner rulings D3/D4).
 *
 * Every require above is retained; nothing here loads anything eagerly. Two
 * maps are registered because this process legitimately spans both trees:
 * cli/wprism-classmap.php covers the 124 WPrism\Orchestrator\* types under cli/src
 * (all are already declared once the require block above finishes, so that
 * registration is pure insurance), and agent/wprism-classmap.php covers the 281
 * WPrism\* types under agent/src. This bootstrap declares only the narrow bridge
 * it needs directly; the remaining names arrive later and by hand:
 * RefreshPlan::loadCompiler() require_once's its agent-side compiler graph, and
 * AdapterCatalog/AdapterDraft/ManifestValidate each have their own boot()
 * that requires the Canon/OptionState/ManifestDispositions/Policy set (plus,
 * in AdapterCatalog's case, the AdapterRegistry it names statically). Those
 * hand-written lists stay exactly as they are — this only removes the
 * "Class not found" cliff between them.
 *
 * The two maps have disjoint key spaces (WPrism\Orchestrator\* vs single-segment
 * WPrism\*), so registration order carries no meaning. Manifest-shipped code
 * (WPrism\Interpreters\*, WPrism\Providers\*, WPrism\Regenerators\*) is in neither
 * map, which is what keeps Policy.php:1455/1519 and Providers.php:2047 —
 * the "your manifest's PHP must define this class" diagnostics — reachable.
 *
 * The is_file() test is load-bearing here specifically. cli/src/Refresh/RefreshPlan.php
 * is required under an `is_file()` guard above because the semantic planner is
 * a separately-reviewable layer that may be absent, and Refresh::planner()
 * (cli/src/Refresh/Refresh.php:673) turns that absence into an actionable
 * "refresh semantic planner is unavailable" refusal via class_exists(). A bare
 * require_once through the map would replace that refusal with an uncatchable
 * failed-to-open fatal in exactly the degraded tree the guard exists for.
 */
if (!defined('WPRISM_ORCHESTRATOR_CLASSMAP_REGISTERED')) {
    define('WPRISM_ORCHESTRATOR_CLASSMAP_REGISTERED', true);
    /** @var array<string,string> $wprismOrchestratorClassmap */
    $wprismOrchestratorClassmap = require __DIR__ . '/wprism-classmap.php';
    spl_autoload_register(static function (string $class) use ($wprismOrchestratorClassmap): void {
        if (!isset($wprismOrchestratorClassmap[$class])) {
            return;
        }
        $file = __DIR__ . '/' . $wprismOrchestratorClassmap[$class];
        if (is_file($file)) {
            require_once $file;
        }
    });
}
if (!defined('WPRISM_CLASSMAP_REGISTERED')) {
    define('WPRISM_CLASSMAP_REGISTERED', true);
