require_once __DIR__ . '/src/Command/CodeResolveCommand.php';
require_once __DIR__ . '/src/Command/CodeImportCommand.php';
require __DIR__ . '/src/Command/ContractCommand.php';
// Demo now composes the real contract propose/accept reader. Keep its plain
