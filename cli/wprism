// path, so a plain `require` here would redeclare whichever of them this block
// already pulled in (:80-84 states the rule this follows).
require_once __DIR__ . '/src/Refresh/MergeCheck.php';
require_once __DIR__ . '/src/Command/MergeCheckCommand.php';
// Round-3 MUP §2.1/§2.6. Deliberately last in this block: every class
// below `require_once`s its own dependencies by path, and this file's
// convention is a bare `require`, so a leaf loaded early here would be
// redeclared when its own dependant pulled it in. Ordering within the
