/**
 * Host-level code deploy: the immutable artifact plus the code
 * stage/lifecycle/finalize sequence, under one target lease.
 *
 * It takes a whole-database checkpoint under that lease, at the position
 * promote takes its own — after `promotion-begin`, before `code-stage` — and
 * retains it at `<repo>/.wprism/checkpoints/deploy-<owner>.sql.enc`, the sibling of
 * the `deploy-<owner>.json` artifact it just compiled. `wprism recover <env>
 * --list` lists it as a `retained-release-checkpoint` and `--restore` drives
 * the same four ordered steps a promote checkpoint gets. `--no-checkpoint`
 * skips the export for an operator who has weighed the dump's cost on a large
 * target; that arm reproduces the pre-checkpoint stream exactly.
 *
 * What deploy still does NOT do is promote's trailing state `apply` and
 * `VerifiedRollbackProfile::select()`'s SSH verified-rollback profile. Both
 * are product claims promote publishes into a frozen authorization plan;
 * deploy emits no such document, so claiming them here would be a claim with
 * nothing behind it.
 */
function cmd_deploy(EnvironmentDriver $t, array $extra): int {
    return DeployCommand::run(
        $t,
        $extra,
        static fn(array $args): ?int => reject_unsupported_scope_contract('deploy', $args),
        static fn(EnvironmentDriver $driver): bool => rollback_authority_fence($driver, 'deploy'),
        static fn(): string => orchestrator_run_id(),
        static function (EnvironmentDriver $driver, array $begin, string $owner, string $artifactHash): void {
            compensate_uncertain_begin($driver, $begin, $owner, $artifactHash, 'deploy');
        },
        static fn(EnvironmentDriver $driver, string $owner, string $artifactHash): bool => promotion_abort($driver, $owner, $artifactHash),
        static function (EnvironmentDriver $driver, string $checkpoint, bool $codeMayHaveChanged): void {
            print_promotion_recovery($driver, $checkpoint, $codeMayHaveChanged, 'deploy');
        }
    );
}

