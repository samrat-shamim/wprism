                          ref-hint offers a y/N prompt to attach `ref=<kind>`.
                          All decisions batch into one `wp wprism classify --set=...`
                          call at the end; its output streams live and its
                          exit code propagates. Prints "N classified, M
                          skipped" as a final summary line.
  classify <env>
    --accept-proposals    Non-interactive: accepts every item that has a
                          proposal, except secret-flagged items proposed
                          "authored" (those are skipped loudly — they need a
                          human). Exit 0 if the queue was empty or fully
                          handled; non-zero if any secret-authored items had
                          to be skipped.
    --export-batch=<path> Write a value-redacted, queue-bound review artifact.
                          Refuses to overwrite an existing path. Fill every
                          decisions[].class, then apply the same artifact.
    --apply-batch=<path>  Apply a fully-reviewed batch only when its env and
                          pending-queue SHA-256 still match. Stale or partial
                          batches refuse before any remote policy write.
    [--limit=<1..200>]    Rows of the skipped-item listings to print
                          (default 50). The counts in the sentences above
                          them stay the true totals.
  coverage <env>          Names and counts what this site actually has versus
                          what WPrism can see (options, custom tables) —
                          deliberately NOT a gate: never blocks capture/plan/
                          apply, never appears in `pending`'s queue, purely
                          additive visibility for an operator deciding how
                          much of a site is really under management.
  coverage <env>
    --format=json         Raw passthrough of the agent's own JSON (same
                          precedent as `wprism plan --format=json`), instead of
                          the rendered summary.
  scope <env>             Resolves a bounded set of entities from explicit
                          roots and previews what it would carry: the roots,
                          everything pulled in by a declared dependency edge
                          (each row naming the edge responsible), inbound
                          references left out, and how much unrelated state
                          is excluded. Read-only — it captures, promotes, and
                          deletes nothing. Unrelated to site.wprism.json's
                          `policy.scope`, which classifies whole post types
                          and taxonomies rather than selecting entities.
    --roots=<selectors>   Comma-separated. post:<uuid>, term:<uuid>,
                          table:<table>:<uuid>, menu:<slug>, sidebar:<id>,
                          user-meta:<login>, options,
                          path:<state-relative-path>, or `all` for the whole
                          revision. A root that does not resolve is refused,
                          never silently dropped.
    --format=json         Raw passthrough of the agent's own JSON.
    --contract            Emit canonical `wprism-scope-contract/v1` immutable
                          read-only evidence rather than the legacy preview.
                          The host runs scope through the isolated control
                          plane, so plugins, themes, and normal MU code are
                          not booted before this target-independent compile.
  refresh <production-env> --production-ref=<ref> [--scope-contract=<p>] [--field-diff [--format=json]]
                          Fetches only a read-only live production export and
                          writes an immutable semantic B/P/W plan locally.
                          The Git ref verifies code topology; it never stands
                          in for production database truth.
    --field-diff          Emit a value-free, non-authorizing field-level
                          change diff. Optional --format=json emits that
                          same closed diff object.
  rebase <production-env> --production-ref=<ref> --new-branch=<name> [--scope-contract=<p>] [--field-resolution=<p>|--interactive]
                          Builds a candidate only in a disposable local
                          worktree, then atomically creates a new branch after
                          semantic state validation. Source branch is untouched.
    --field-resolution=<p>
                          Supplies canonical local automation input; it does
                          not reveal source values.
    --interactive         TTY-only privileged comparison: shows sanitized
                          labels plus bounded exact B/W/P value/path previews,
                          byte counts, and SHA-256 hashes before choosing
                          branch or production. This sensitive terminal output
                          is never written to JSON, a diff, resolution, run,
                          or receipt. It is
                          mutually exclusive with legacy --strategy/--resolve;
                          q or EOF cancels before candidate worktree, branch,
                          or ref creation. Use --field-resolution for pipes.
  rebase <production-env> --abort=<run-id>
                          Removes only the retained candidate worktree named
                          by an interrupted run journal.
  census                  Fold N `wprism-assess-inventory/v1` documents into one
    --site=<label>=<f>    `wprism-fleet-census/v1`: a demand rank (plugins by
    [--dir=<dir>]         sites installed x surface no reviewed adapter
    [--manifests=<dir>]   covers), a coverage ratio per site and for the
    [--health=<f>]        fleet with the residual NAMED, and the adoption
    [--limit=<1..200>]    funnel — an adapter exists, it covers your plugin,
    [--format=json]       your site pins it. No environment, no target, no
                          WordPress: the inputs are documents `wprism assess`
                          already produced locally, and the coverage oracle is
                          this checkout's manifest library (--manifests to
                          point elsewhere).
                          Every submission needs an OPAQUE label: up to 32
                          lowercase letters, digits, hyphens or underscores,
                          and no dot, slash, colon or @, so a label cannot be a
                          hostname. --dir labels each *.json by its stem
                          through the same grammar, so a file saved under a
                          site's domain name is refused rather than pooled.
                          Only names and counts leave a submission — no option
                          value, no site URL and no review-queue row is read at
                          all. A multisite submission is EXCLUDED (the platform
                          claims single-site) and the excluded population is
                          published beside the eligible denominator rather than
                          dropped, and `basis.sample_class` says whether the
                          rank rests on one estate or a fleet.
                          --health takes the derived document `wprism adapter
                          proposals --format=json` emits and adds fleet-health
                          rows: per adapter, the newest release that probed
                          green, how many recorded releases are newer, and any
                          open range proposal — ranked by sites pinning it x
                          releases behind, because "four releases behind" and
                          "eleven sites pin it" are one decision. Only names
                          and counts are read out of that document too.
  census                  The cohort re-baseline. Given the census you kept
    --baseline=<f>        before a cohort and the one that describes the estate
    [--current=<f>]       now, emits `wprism-cohort-rebaseline/v1`: the coverage-
    [--dir=<dir>]         ratio delta, funnel movement stage by stage, and
    [--limit=<1..200>]    per-adapter attribution — which adapter's claim moved
    [--format=json]       which surfaces, with `claimed`, `regressed`,
                          `appeared` and `resolved` kept apart so a net number
                          cannot hide a narrowed claim. The current side is
                          either a census you already have (--current) or one
                          measured now from --site/--dir submissions; naming
                          both is refused.
                          `cohort.verdict` is a closed word: coverage_moved,
                          adoption_only, shipped_without_movement,
                          coverage_regressed, no_cohort, unmeasured. A cohort
                          that ships every adapter and moves no ratio reads
                          shipped_without_movement and carries a FINDING —
                          that is a result that re-opens the demand rank, not a
                          success, and it is a fact inside the document rather
                          than a fourth exit code.
                          `comparability.class` says whether the two censuses
                          even describe one estate (same-estate,
                          population-changed, disjoint-estate) and only the
                          first makes the delta attributable to a cohort. A
                          different platform boundary refuses; a different
                          AGENT or spec version does not, because a program
                          worth re-baselining usually crossed one.
                          The loop this grades — rank, probe, draft, boundary,
                          vectors, kit, certify, bulk-adopt, re-measure — is
                          docs/guides/coverage-cohort.md.

Global flags:
  --envs-file=<path>      Explicitly trust and load the machine-local overlay
                          registry at <path> instead of auto-discovering an
                          untracked .wprism-envs.json at the site/Git root.
  -h, --help              Show this help.

Environment registry ('envs' key, in site.wprism.json and/or .wprism-envs.json):
  {"envs": {
    "e1":    {"transport": "docker", "compose_file": "sandbox/docker-compose.yml",
              "profile": "spikee", "service": "cli-e1", "repo_path": "/siterepo"},
    "stage": {"transport": "ssh", "host": "deploy@stage.example.com",
              "wp_path": "/var/www/html", "repo_path": "/srv/site"},
    "dev":   {"transport": "local", "wp_path": "/var/www/html",
              "repo_path": "/home/me/site"}
  }}

Environment names must match [A-Za-z0-9][A-Za-z0-9._-]{0,63}; names that
look like options or contain whitespace/control bytes are refused.

site.wprism.json is found at the current Git worktree root (search starts at the
current directory); its auto-discovered .wprism-envs.json must sit beside it. A
nested registry/overlay is refused. The overlay replaces same-named entries
entirely — no per-key merge. See cli/README.md for the full contract, transport
requirements, and the explicit --envs-file trust override.
TXT;
}

/** @return never */
function wprism_fail(string $message, int $code = 1) {
    CommandOutput::fail($message, $code);
}

/** The host owns JSON refusals for commands it preflights locally. */
function wants_agent_refusal_json(string $verb, array $extra): bool {
    return CommandOutput::wantsAgentRefusalJson($verb, $extra);
}

/** Emit the same stable envelope as the target agent without exposing host exception text. */
function render_agent_refusal_json(
    string $command,
    string $reasonCode,
    string $message,
    string $remediation,
    array $diagnostics = []
): int {
    return CommandOutput::renderRefusalJson($command, $reasonCode, $message, $remediation, $diagnostics);
}

function main(array $argv): int {
    array_shift($argv); // script path

    $envsFileOverride = null;
    $showHelp = false;
    $rest = [];
    foreach ($argv as $a) {
        if ($a === '-h' || $a === '--help') {
            $showHelp = true;
        } elseif (str_starts_with($a, '--envs-file=')) {
            $envsFileOverride = substr($a, strlen('--envs-file='));
        } else {
            $rest[] = $a;
        }
    }

    if ($showHelp) {
        echo wprism_usage() . "\n";
        return 0;
    }
    if (count($rest) === 0) {
        echo wprism_usage() . "\n";
        return 1;
    }

    $verb = array_shift($rest);
    if ($verb === 'envs') {
        return cmd_envs($envsFileOverride);
    }
    if ($verb === 'env') {
        return cmd_environment($rest, $envsFileOverride);
    }
    if ($verb === 'connect') {
        return ConnectCommand::run($rest, dirname(__DIR__));
    }
    if ($verb === 'demo') {
        return DemoCommand::run($rest, dirname(__DIR__));
    }
    if ($verb === 'preview') {
        $action = array_shift($rest);
        if ($action === 'create') {
            if (in_array('--reap', $rest, true)) {
                fwrite(STDERR, "wprism: preview create does not accept --reap\n");
                return 1;
            }
            $verb = 'rehearse';
        } elseif ($action === 'remove') {
            $flags = array_slice($rest, 1);
            if ($rest === []
                || count(array_filter($flags, static fn(string $arg): bool => $arg === '--format=json')) > 1
                || array_filter($flags, static fn(string $arg): bool => $arg !== '--format=json') !== []) {
                fwrite(STDERR, "wprism: preview remove accepts only <env> and optional --format=json\n");
                return 1;
            }
            $verb = 'rehearse';
            $rest[] = '--reap';
        } else {
            fwrite(STDERR, "wprism: preview requires create or remove\n");
            return 1;
        }
    }

    // No environment or transport: this reads one explicit adapter library on
    // this machine and drives the engine's own offline validators over it.
    if ($verb === 'manifest-validate') {
        return ManifestValidate::run($rest);
    }

    // WP-4.12: `wprism release --spec-v3 <site-repo>` is the flag-day migration
    // act for ONE REPOSITORY, and it is intercepted here — before the
    // environment, transport and driver-capability machinery `release` itself
    // needs — because it takes a site repo rather than an <env> and touches no
    // target at all. Same shape and same reason as `manifest-validate` and
    // `merge-check` above: the operator most likely to run it is mid-migration,
    // which is exactly when an environment-bound verb is least reachable. The
    // interception is on the FLAG, so `wprism release <env>` keeps every byte of
    // its own parsing, refusals and output.
    if ($verb === 'release' && in_array(SpecMigration::RELEASE_FLAG, $rest, true)) {
        return SpecMigration::runRelease($rest);
    }

    // Same shape, same reason (WP-2.4): the suspicious-reference linter over a
    // captured tree on THIS machine. It runs the engine's real
    // Lint::scan_tree() — the same static method `wp wprism lint` calls — over a
    // recorded `wprism-lint-environment/v1` transcript, so its findings are the
    // live verb's byte for byte. No environment, no transport, no WordPress.
    if ($verb === 'lint-tree') {
        return LintTree::run($rest);
    }

    // Same shape, same reason (issue #3325): the safe adapter-DRAFT generator reuses
    // policy-to-manifest's facts core (Policy::export_manifest) and adds offline
    // proposers over a site repo's captured state/**, emitting inert `_draft`
    // candidates a human ratifies by hand. WordPress-free, no environment, no
    // transport — it observes files on this machine and writes nothing live.
    if ($verb === 'adapter-draft') {
        return AdapterDraft::run($rest);
    }

    // Same shape, same reason (issue #3339): the adapter catalog reports what is
    // installed on THIS machine and where it came from. It sits beside
    // manifest-validate rather than in the environment-bound vocabulary deliberately — the
    // operator most likely to run `wprism adapter doctor` is the one whose
    // repository is in a state that makes every environment-bound command
    // refuse, and requiring an <env> would put the answer behind the problem.
    if ($verb === 'adapter') {
        // Same process, three owners. `list|inspect|doctor` REPORT what is
        // installed; `keygen|certify|pin` MUTATE — a private key, the site
        // trust root, a certificate, a pin. Splitting on the sub-verb rather
        // than widening AdapterCatalog's parser keeps the read-only catalog
        // free of every write path, which is what lets `wprism adapter doctor`
        // stay the command an operator can run when the repository is in a
        // state that makes the writing ones refuse.
        //
        // `boundary` is a third owner rather than a fourth catalog verb: it
        // reads two RECORDED documents and no installed adapter at all, and it
        // is the one verb here with a fourth exit code (3, "probe this next"),
        // which AdapterCatalog's 0/1/2 contract has no room for.
        if (in_array($rest[0] ?? '', AdapterBoundary::VERBS, true)) {
            return AdapterBoundary::run($rest);
        }
        // `proposals` is the scheduled job AROUND that planner: it re-bisects
        // every pinned plugin from its own recorded ledger and derives how
        // stale each adapter's proof is. It is a fourth owner rather than a
        // flag on `boundary` because it answers about the LIBRARY rather than
        // about one slug, and because it deliberately drops boundary's exit 3
        // ("probe this release next") — a job over sixteen adapters has as many
        // next-probes as it has incomplete searches, and collapsing them into
        // one process status would make a driver loop probe the first forever.
        if (in_array($rest[0] ?? '', AdapterProposals::VERBS, true)) {
            return AdapterProposals::run($rest);
        }
        if (in_array($rest[0] ?? '', AdapterCertify::VERBS, true)) {
            return AdapterCertify::run($rest);
        }
        // WP-5.6: `discover|install|update` is a sixth owner, and the split is
        // the sharpest one here. Every other verb in this family answers about
        // bytes that are ALREADY on this disk; these three are the only ones
        // that resolve a document describing bytes that are not, and the only
        // ones with a transport at all. Keeping the resolution ladder — fetch,
        // digest, verify, enrolled-authority — out of the read-only catalog and
        // out of the signing verb is what lets each of the three be read on its
        // own.
        if (in_array($rest[0] ?? '', AdapterDistribution::VERBS, true)) {
            return AdapterDistribution::run($rest);
        }
        // WP-4.12: `recertify` is a fifth owner rather than a fifth
        // AdapterCertify verb, and the split is the same one that put
        // `boundary` and `proposals` in their own classes. It mutates the same
        // two files `certify` does and reuses that class's bootstrap, key
        // reader and certificate writer — but it is a FLEET verb: it acts on
        // every certificate a repository holds, all-or-nothing, and reports a
        // per-adapter row matrix that `certify`'s single-subject output has no
        // room for.
        if (in_array($rest[0] ?? '', SpecMigration::VERBS, true)) {
            return SpecMigration::run($rest);
        }
        return AdapterCatalog::run($rest);
    }

    // Same shape, same reason: `code-import` reads one archive on THIS machine
    // into the host's content-addressed code-artifact cache. The cache is a
    // property of the host, not of a site, and the import has to be possible
    // before the `wprism init` that classifies the component — so no environment
    // and no transport, exactly like manifest-validate.
    if ($verb === 'code-import') {
        return CodeImportCommand::run($rest);
    }

    // Same shape, same reason, and the sharpest case for it: `merge-check`
    // compiles one or two Git refs with the real repository compiler and
    // plans B/P/W from them, so it needs no environment, no transport and no
    // registry at all. The operator most likely to need it is the one holding
    // a freshly line-merged `state/` tree and NO production target they can
    // reach — the moment the answer matters most is the moment every
    // environment-bound verb refuses. Its plan is explicitly advisory and can
    // never drive `rebase` (Refresh::assertAuthorizingPlan()).
    if ($verb === 'merge-check') {
        return MergeCheckCommand::run($rest);
    }

    // Same shape, same reason, one step further out: `census` has no target at
    // all. It folds N `wprism-assess-inventory/v1` documents an operator already
    // produced locally against this checkout's own manifest library and emits
    // `wprism-fleet-census/v1` — no WordPress, no database, no environment, no
    // registry. The question it answers ("which adapter is worth building
    // next, and which existing one is simply unpinned") is a question about a
    // FLEET, so binding it to any single <env> would be a category error.
    if ($verb === 'census') {
        return CensusCommand::run($rest);
    }

    if (!EnvironmentCommandPreflight::requiresEnvironment($verb)) {
        fwrite(STDERR, "wprism: unknown verb '$verb'\n\n" . wprism_usage() . "\n");
        return 1;
    }
    if (count($rest) < 1 || str_starts_with((string) $rest[0], '--')) {
        if (wants_agent_refusal_json($verb, $rest)) {
            return render_agent_refusal_json(
                $verb,
                'invalid_arguments',
                "an environment argument is required for $verb",
                "supply a trusted <env> before the JSON flags and rerun $verb"
            );
        }
        wprism_fail("'$verb' requires an <env> argument");
    }
    $envName = array_shift($rest);
    $extra = $rest;
    $scopeWireRefusal = reject_scope_wire_flag($verb, $extra);
    if ($scopeWireRefusal !== null) {
        return $scopeWireRefusal;
    }
    $scopeVerbRefusal = reject_unsupported_scope_contract($verb, $extra);
    if ($scopeVerbRefusal !== null) {
        return $scopeVerbRefusal;
    }
    $jsonRefusal = wants_agent_refusal_json($verb, $extra);

    try {
        $transport = EnvironmentCommandPreflight::resolveTransport($envsFileOverride, getcwd() ?: '.', $envName);
    } catch (\Throwable $e) {
        if ($jsonRefusal) {
            return render_agent_refusal_json(
                $verb,
                'host_preflight_failed',
                'the host could not resolve a trusted environment driver for this command',
                'check the environment name and trusted registry, then retry the command'
            );
        }
        throw $e;
    }

    if ($verb === 'driver-capabilities') {
        return cmd_driver_capabilities($transport, $extra);
    }

    try {
        $capabilityOperation = match (true) {
            $verb === 'onboard' && in_array('--handoff-only', $extra, true) => 'onboard-handoff',
            $verb === 'release' && ($extra[0] ?? null) === 'prepare' => 'release-prepare',
            $verb === 'release' && ($extra[0] ?? null) === 'status' => 'release-status',
            default => $verb,
        };
        $driverReport = EnvironmentCommandPreflight::capabilityReport($transport, $capabilityOperation);
    } catch (\Throwable $e) {
        if ($jsonRefusal) {
            return render_agent_refusal_json(
                $verb,
                'driver_preflight_failed',
                'the environment driver could not produce a valid capability report',
                'repair the driver configuration or implementation, then retry the command'
            );
        }
        fwrite(STDERR, "wprism: driver preflight: {$e->getMessage()}\n");
        return 1;
    }
    if (!$driverReport->ready()) {
        if ($jsonRefusal) {
            $diagnostics = array_map(
                static fn(array $blocker): array => [
                    'code' => 'driver_capability_missing',
                    'capability' => (string) $blocker['capability'],
                    'state' => (string) $blocker['state'],
                    'message' => 'the required driver capability is unsupported',
                    'remediation' => (string) $blocker['remediation'],
                ],
                $driverReport->blockers()
            );
            return render_agent_refusal_json(
                $verb,
                'driver_unsupported',
                'the environment driver does not support this command',
                'resolve every capability diagnostic, then retry the command',
                $diagnostics
            );
        }
        render_driver_blockers($driverReport);
        return 1;
    }

    // Recovery debt is outside the database and managed code by design. Ask
    // the target filesystem directly, so code-first rollback to an older agent
    // cannot make an empty/partial import look like a fresh environment. Only
    // diagnostics and the exact legacy restore path may cross this fence.
    $recoveryControlRequired = $driverReport->requiresRecoveryControl();
    $recoveryResume = $verb === 'recover'
        && (($extra === [] || in_array('--list', $extra, true))
            || count(array_filter(
                $extra,
                static fn(string $arg): bool => str_starts_with($arg, '--restore=')
            )) === 1)
        && !in_array('--confirm-prune', $extra, true)
        && count(array_filter(
            $extra,
            static fn(string $arg): bool => str_starts_with($arg, '--prune-retained=')
        )) === 0
        && !in_array($extra[0] ?? '', ['prepare', 'execute'], true);
    $deferRecoveryFence = $recoveryControlRequired
        && !$recoveryResume
        && in_array($verb, ['capture', 'plan', 'apply', 'promote', 'refresh', 'rebase'], true)
        && count(array_filter(
            $extra,
            static fn(string $arg): bool => PassthroughCommand::isScopeContractFlag($arg)
        )) > 0;
    $bootstrapAuthority = null;
    if ($recoveryControlRequired && !$recoveryResume && !$deferRecoveryFence) {
        $fenceRefusal = external_recovery_fence_refusal($transport, $verb, $extra, $bootstrapAuthority);
        if (is_int($fenceRefusal)) {
            return $fenceRefusal;
        }
    }
    $beforeTarget = $deferRecoveryFence
        ? static fn(): ?int => external_recovery_fence_refusal($transport, $verb, $extra)
        : null;

    return match ($verb) {
        'doctor' => cmd_doctor($transport),
        'adopt' => cmd_adopt($transport, $extra, $bootstrapAuthority),
        'unadopt' => cmd_unadopt($transport, $extra),
        'onboard' => OnboardCommand::run(
            $transport,
            $extra,
            dirname(__DIR__),
            [
                'status' => static fn(EnvironmentDriver $driver): int => cmd_status($driver, [], $envsFileOverride),
                'adopt' => static fn(EnvironmentDriver $driver, array $args, string $sourceRoot): int =>
                    AdoptCommand::run($driver, $args, $sourceRoot, $bootstrapAuthority),
            ]
        ),
        'init' => cmd_init($transport, $extra, $envsFileOverride),
        'status' => cmd_status($transport, $extra, $envsFileOverride),
        'assess' => cmd_assess($transport, $extra),
        'contract' => cmd_contract($transport, $extra),
        'adapter-observe' => cmd_adapter_observe($transport, $extra),
        'capabilities', 'lint', 'plan', 'explain', 'apply', 'coverage' => cmd_passthrough(
            $transport,
            $verb,
            $extra,
            $beforeTarget
        ),
        'env-set' => PassthroughCommand::runEnvSet($transport, $extra),
        'capture' => cmd_capture($transport, $extra, $envsFileOverride, $beforeTarget),
        'scope' => cmd_scope($transport, $extra),
        'deploy' => cmd_deploy($transport, $extra),
        'promote' => cmd_promote($transport, $extra, $beforeTarget),
        'stage-source' => StageSourceCommand::run($transport, $extra),
        'authority-policy' => AuthorityPolicyCommand::run($transport, $extra),
        'release' => cmd_release($transport, $extra),
        'verify' => cmd_verify($transport, $extra),
        'recover' => cmd_recover($transport, $extra),
        'rehearse' => cmd_rehearse($transport, $extra, $envsFileOverride),
        'pending' => cmd_pending($transport, $extra),
        'classify' => cmd_classify($transport, $extra),
        'code-classify' => CodeClassifyCommand::run($transport, $extra),
        'code-resolve' => CodeResolveCommand::run($transport, $extra),
        'refresh' => cmd_refresh($transport, $extra, $beforeTarget),
        'rebase' => cmd_rebase($transport, $extra, $beforeTarget),
    };
}

/**
 * Read-only assessment. `dirname(__DIR__)` is this checkout's root, which the
 * adoption probe needs to compare against the target's control-plane artifact
 * — the same argument `cmd_adopt()` passes for the same reason.
 */
function cmd_assess(EnvironmentDriver $driver, array $extra): int {
    return AssessCommand::run($driver, $extra, dirname(__DIR__));
}

