// register_argc_argv is configurable; an unavailable argument vector must
// take main()'s normal usage path rather than fail before command parsing.
$cliArgv = $_SERVER['argv'] ?? [];
$argv = is_array($cliArgv) ? array_map('strval', $cliArgv) : [];
try {
    exit(main($argv));
} catch (\Throwable $e) {
    wprism_fail($e->getMessage());
}
