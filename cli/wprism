/**
 * Map the version-independent filesystem fence's closed state vocabulary to
 * the public host refusal. The transport's prose is never parsed here.
 */
function external_recovery_fence_refusal(
    EnvironmentDriver $transport,
    string $verb,
    array $extra,
    ?BootstrapEligibilityReport &$bootstrapAuthority = null
): ?int {
    $fence = CodeDeploy::externalRecoveryFence($transport, $transport->repoPath());
    $state = (string) ($fence['state'] ?? 'unsafe');
    if ($state === 'clear') {
        return null;
    }
    // RecoveryFence remains strict for every already-managed operation. Only
    // the adoption owner can positively prove a pristine initial target, and
    // carries that proof into the generation writer rather than treating a
    // missing repository as clear recovery state.
    $initialAdoption = $verb === 'adopt'
        || ($verb === 'onboard' && !in_array('--handoff-only', $extra, true) && ($extra[0] ?? '') !== 'status');
    if ($state === 'unsafe' && $initialAdoption && $transport instanceof \WPrism\Orchestrator\AdoptionTransport) {
        $bootstrapAuthority = BootstrapEligibilityReport::initialRecoveryAuthority($transport, dirname(__DIR__));
        if ($bootstrapAuthority !== null) {
            return null;
        }
    }
    [$reasonCode, $message, $remediation] = match ($state) {
        'provider_settlement' => [
            'provider_settlement_incomplete',
            'an incomplete adapter provider settlement blocks this command',
            'resume the exact retained checkpoint with wprism recover before observing or mutating this environment',
        ],
        'checkpoint_recovery' => [
            'checkpoint_recovery_incomplete',
            'an incomplete database recovery blocks this command',
            'resume the exact retained checkpoint with wprism recover before observing or mutating this environment',
        ],
        default => [
            'external_recovery_state_unreadable',
            'the database-external recovery fence could not be read safely',
            'repair the adopted control directory boundary, then rerun wprism doctor',
        ],
    };
    if (wants_agent_refusal_json($verb, $extra)) {
        return render_agent_refusal_json($verb, $reasonCode, $message, $remediation);
    }
    fwrite(STDERR, "wprism: $message; $remediation\n");
    return 1;
}

