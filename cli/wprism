/** Render externally verified rollback authority state for targets that carry it. */
function render_rollback_authority_status(EnvironmentDriver $t): bool {
    // carriesRollbackAuthority() is the cheap local predicate, not a target
    // read: SSH answers true unconditionally, so this line stays byte-identical
    // for every SSH environment, and a transport admitted to the interface
    // later prints nothing until its own configuration opts in.
    if (!$t instanceof \WPrism\Orchestrator\RecoveryTransport || !$t->carriesRollbackAuthority()) {
        return true;
    }
    $status = RollbackAuthority::status($t);
    if (($status['available'] ?? false) !== true) {
        echo "[WARN] rollback authority: unavailable (manual recovery only)\n";
        return true;
    }
    if (($status['ok'] ?? false) !== true) {
        $detail = trim((string) ($status['error'] ?? 'verification failed'));
        echo "[FAIL] rollback authority: invalid — $detail\n";
        return false;
    }
    if (($status['active'] ?? false) !== true) {
        echo "[PASS] rollback authority: ready (no active generation)\n";
        return true;
    }
    $state = (string) ($status['state'] ?? 'unknown');
    $generation = (int) ($status['generation'] ?? 0);
    $receipt = (string) ($status['receipt_id'] ?? 'unknown');
    if (!empty($status['terminal'])) {
        echo "[PASS] rollback authority: generation $generation $state receipt=$receipt\n";
        return true;
    }
    echo "[FAIL] rollback authority: generation $generation $state receipt=$receipt (recovery required)\n";
    return false;
}

/** Refuse a new mutation while external authority is corrupt or nonterminal. */
function rollback_authority_fence(EnvironmentDriver $t, string $verb): bool {
    if (!$t instanceof \WPrism\Orchestrator\RecoveryTransport || !$t->carriesRollbackAuthority()) {
        return true;
    }
    $status = RollbackAuthority::status($t);
    if (($status['available'] ?? false) !== true) {
        return true;
    }
    if (($status['ok'] ?? false) !== true) {
        $detail = trim((string) ($status['error'] ?? 'verification failed'));
        fwrite(STDERR, "wprism: $verb: rollback authority is invalid; refusing target mutation: $detail\n");
        return false;
    }
    if (($status['active'] ?? false) === true && empty($status['terminal'])) {
        fwrite(
            STDERR,
            "wprism: $verb: rollback generation {$status['generation']} is still {$status['state']}; recovery must reach committed or rolled_back first\n"
        );
        return false;
    }
    return true;
}

