require_once dirname(__DIR__) . '/agent/src/Kernel/Secrets.php';
require_once dirname(__DIR__) . '/agent/src/Repository/ReferenceGraph.php';
require_once dirname(__DIR__) . '/agent/src/Policy/ScopeClosure.php';
