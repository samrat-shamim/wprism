#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * duo — host-agnostic multi-environment orchestrator.
 *
 * Git stays git; this wraps the per-environment `wp duo capture|plan|apply`
 * agent commands (agent/src/Cli.php) over local/docker/ssh transports, plus
 * `envs`/`doctor`/`status` conveniences. Dependency-free PHP 8+ — no
 * composer, no WordPress required on the machine running `duo` itself.
 *
 * See cli/README.md for the environment registry format.
 */

require __DIR__ . '/src/Registry.php';
require __DIR__ . '/src/Transport.php';
require __DIR__ . '/src/LocalTransport.php';
require __DIR__ . '/src/DockerTransport.php';
require __DIR__ . '/src/SshTransport.php';
require __DIR__ . '/src/Doctor.php';
require __DIR__ . '/src/PlanSummary.php';
require __DIR__ . '/src/Pending.php';
require __DIR__ . '/src/Triage.php';

use Duo\Orchestrator\Doctor;
use Duo\Orchestrator\Pending;
use Duo\Orchestrator\PlanSummary;
use Duo\Orchestrator\Registry;
use Duo\Orchestrator\Transport;
use Duo\Orchestrator\Triage;

function duo_usage(): string {
    return <<<TXT
duo — host-agnostic orchestrator for Duo environments

Git stays git: `duo` wraps the per-environment `wp duo …` agent commands
over local/docker/ssh transports and adds cross-environment ergonomics.

Usage:
  duo envs
  duo doctor <env>
  duo status <env>
  duo capture <env> [extra wp-cli flags...]
  duo plan    <env> [extra wp-cli flags...]
  duo apply   <env> [extra wp-cli flags...]
  duo env-set <env> --name=<name> (--value=<value> | --stdin)
  duo promote <env> [extra apply flags...]
  duo pending <env>
  duo classify <env> [--accept-proposals]
  duo -h | --help

Verbs:
  envs                    List environments from site.duo.json + .duo-envs.json
                          (overlay wins per env name), with transport summaries.
  doctor <env>            Check transport reachability, WordPress install, the
                          duo agent, and repo_path/site.duo.json. Non-zero exit
                          on any failing check.
  status <env>            Run `wp duo plan --format=json` and print counts per
                          plan bucket (incl. deletion conflicts and
                          code_mismatch), drift paths, blocked deletes,
                          code_mismatch findings, and any
                          plan-level warnings. Non-zero exit ("not safe to
                          promote") if the plan has any conflict, deletion
                          conflict, collision, code_mismatch, blocked delete,
                          a required env_missing entry (env-set --name=<name>
                          --stdin to provision it), or drift (drift is
                          the one case `duo apply` itself does not refuse
                          on, but status still reports as not clean — see
                          cli/src/PlanSummary.php's decision-matrix
                          comment), or if the underlying `wp duo plan` call
                          failed or returned unparseable JSON. Warnings
                          alone never flip this.
  capture <env> [...]     `wp duo capture --repo=<repo_path> [...]`
  plan <env> [...]        `wp duo plan    --repo=<repo_path> [...]`
  apply <env> [...]       `wp duo apply   --repo=<repo_path> [...]`
                          Extra flags (e.g. --adopt-by-slug=terms
                          --default-author=admin, --with-deletes) are forwarded
                          verbatim. Output streams live; exit code is the agent's.
  env-set <env>           `wp duo env-set --repo=<repo_path> --name=<name>
    --name=<name>         (--value=<value> | --stdin)`. Provisions one
    (--value=<v>|--stdin)   manifest-declared class="env" option on <env> —
                          see `duo status`'s env_missing checklist for what
                          still needs a value. --stdin reads from STDIN with
                          echo disabled and is never logged (deliberately
                          not named --prompt, which wp-cli reserves as its
                          own global flag); --value is scriptable but lands
                          in shell history like any other flag. Refuses any
                          name not declared class="env" by the loaded policy.
  promote <env> [...]     Compile once, export a database checkpoint, then run
                          deploy -> apply against that immutable artifact and one
                          target-DB lease. Stops at the first failed phase and
                          prints the exact database restore command. Apply flags
                          are forwarded verbatim; deploy receives the shared
                          code/compiled flags only. Internal lease flags are owned
                          by promote and rejected from caller input.
  pending <env>           List the review queue (`wp duo pending --format=json`)
                          as a table: section:key, proposal, evidence, ref-hint,
                          and a prominent SECRET flag where present. Exit 0 with
                          "review queue is empty" when there's nothing to triage.
  pending <env>
    --format=json         Raw passthrough of the agent's own JSON (same
                          precedent as `duo plan --format=json`), instead of
                          the rendered table.
  classify <env>          Interactive triage of the review queue, reading
                          decisions from stdin (pipe-friendly — no /dev/tty):
                          per item, Enter accepts its proposal (when one
                          exists); a/r/e/d/m explicitly set
                          authored/runtime/env/derived/managed; s skips; q
                          quits and applies whatever was already decided. An
                          authored decision on a secret-flagged item always
                          requires typing "allow" first — Enter alone can
                          never author a secret. An authored decision with a
                          ref-hint offers a y/N prompt to attach `ref=<kind>`.
                          All decisions batch into one `wp duo classify --set=...`
                          call at the end; its output streams live and its
                          exit code propagates. Prints "N classified, M
                          skipped" as a final summary line.
  classify <env>
    --accept-proposals    Non-interactive: accepts every item that has a
                          proposal, except secret-flagged items proposed
                          "authored" (those are skipped loudly — they need a
                          human). Exit 0 if the queue was empty or fully
                          handled; non-zero if any secret-authored items had
                          to be skipped.

Global flags:
  --envs-file=<path>      Load the machine-local overlay registry from <path>
                          instead of searching upward from the cwd for .duo-envs.json.
  -h, --help              Show this help.

Environment registry ('envs' key, in site.duo.json and/or .duo-envs.json):
  {"envs": {
    "e1":    {"transport": "docker", "compose_file": "sandbox/docker-compose.yml",
              "profile": "spikee", "service": "cli-e1", "repo_path": "/siterepo"},
    "stage": {"transport": "ssh", "host": "deploy@stage.example.com",
              "wp_path": "/var/www/html", "repo_path": "/srv/site"},
    "dev":   {"transport": "local", "wp_path": "/var/www/html",
              "repo_path": "/home/me/site"}
  }}

Both registry files are found by walking upward from the current directory,
git-style. The overlay (.duo-envs.json) replaces same-named entries from
site.duo.json entirely — no per-key merge. See cli/README.md for the full
contract, transport requirements, and the overlay convention.
TXT;
}

/** @return never */
function duo_fail(string $message, int $code = 1) {
    fwrite(STDERR, "duo: $message\n");
    exit($code);
}

function main(array $argv): int {
    array_shift($argv); // script path

    $envsFileOverride = null;
    $showHelp = false;
    $rest = [];
    foreach ($argv as $a) {
        if ($a === '-h' || $a === '--help') {
            $showHelp = true;
        } elseif (str_starts_with($a, '--envs-file=')) {
            $envsFileOverride = substr($a, strlen('--envs-file='));
        } else {
            $rest[] = $a;
        }
    }

    if ($showHelp) {
        echo duo_usage() . "\n";
        return 0;
    }
    if (count($rest) === 0) {
        echo duo_usage() . "\n";
        return 1;
    }

    $verb = array_shift($rest);
    $verbsNeedingEnv = ['doctor', 'status', 'capture', 'plan', 'apply', 'env-set', 'promote', 'pending', 'classify'];

    if ($verb === 'envs') {
        return cmd_envs($envsFileOverride);
    }

    if (!in_array($verb, $verbsNeedingEnv, true)) {
        fwrite(STDERR, "duo: unknown verb '$verb'\n\n" . duo_usage() . "\n");
        return 1;
    }
    if (count($rest) < 1) {
        duo_fail("'$verb' requires an <env> argument");
    }
    $envName = array_shift($rest);
    $extra = $rest;

    $envs = Registry::load($envsFileOverride, getcwd() ?: '.');
    $cfg = Registry::get($envs, $envName);
    $transport = Transport::make($envName, $cfg);

    return match ($verb) {
        'doctor' => cmd_doctor($transport),
        'status' => cmd_status($transport),
        'capture', 'plan', 'apply', 'env-set' => cmd_passthrough($transport, $verb, $extra),
        'promote' => cmd_promote($transport, $extra),
        'pending' => cmd_pending($transport, $extra),
        'classify' => cmd_classify($transport, $extra),
    };
}

function cmd_envs(?string $envsFileOverride): int {
    $envs = Registry::load($envsFileOverride, getcwd() ?: '.');
    if (!$envs) {
        fwrite(STDERR, "duo: no environments defined (looked for an 'envs' object in site.duo.json and .duo-envs.json)\n");
        return 1;
    }
    $width = max(array_map('strlen', array_keys($envs)));
    foreach ($envs as $name => $cfg) {
        try {
            $t = Transport::make($name, $cfg);
            printf("%-{$width}s  %s\n", $name, $t->describe());
        } catch (\Throwable $e) {
            printf("%-{$width}s  ERROR: %s\n", $name, $e->getMessage());
        }
    }
    return 0;
}

function cmd_doctor(Transport $t): int {
    $result = Doctor::run($t);
    foreach ($result['checks'] as $c) {
        // DUO-3231: an advisory check (DISALLOW_FILE_MODS today) never
        // fails the command (Doctor::run()'s own $ok fold already skips
        // it) — labeling a not-ok advisory row WARN rather than FAIL keeps
        // the printed severity honest about that, matching the issue's own
        // "reports its absence as a warning" language rather than implying
        // doctor considers the environment broken.
        $mark = $c['ok'] ? 'PASS' : (!empty($c['advisory']) ? 'WARN' : 'FAIL');
        $line = "[$mark] {$c['label']}";
        if (!$c['ok'] && $c['detail'] !== '') {
            $line .= " — {$c['detail']}";
        }
        echo $line . "\n";
    }
    return $result['ok'] ? 0 : 1;
}

function cmd_status(Transport $t): int {
    $r = $t->captureWp(['duo', 'plan', '--repo=' . $t->repoPath(), '--format=json']);
    if ($r['exit'] !== 0) {
        fwrite(STDERR, "duo: status: failed to fetch plan for '{$t->name()}' (exit {$r['exit']})\n");
        $msg = trim($r['stderr'] !== '' ? $r['stderr'] : $r['stdout']);
        if ($msg !== '') {
            fwrite(STDERR, $msg . "\n");
        }
        return $r['exit'] !== 0 ? $r['exit'] : 1;
    }
    $plan = json_decode(trim($r['stdout']), true);
    if (!is_array($plan)) {
        fwrite(STDERR, "duo: status: could not parse plan JSON for '{$t->name()}'\n");
        fwrite(STDERR, "raw output:\n{$r['stdout']}\n");
        return 1;
    }
    $summary = PlanSummary::render($plan);
    foreach ($summary['lines'] as $line) {
        echo $line . "\n";
    }
    return $summary['ok'] ? 0 : 1;
}

function cmd_passthrough(Transport $t, string $verb, array $extra): int {
    $wpArgs = array_merge(['duo', $verb, '--repo=' . $t->repoPath()], $extra);
    return $t->streamWp($wpArgs);
}

/**
 * DUO-3216's deliberately thin promotion state machine. The architecture
 * ruling keeps deploy's hook-firing window distinct from apply's hard canary,
 * while this host command gives both phases one compiled input and one truthful
 * success boundary. Checkpoints/artifacts live below the target checkout's
 * gitignored .duo directory: durable for docker one-shot containers, outside
 * canonical state, and independent of a git executable existing on the target.
 */
function cmd_promote(Transport $t, array $extra): int {
    foreach ($extra as $arg) {
        if ($arg === '--compiled' || str_starts_with($arg, '--compiled=')
            || $arg === '--promotion-owner' || str_starts_with($arg, '--promotion-owner=')
            || $arg === '--promotion-hold') {
            fwrite(STDERR, "duo: promote owns its compiled artifact and target lease flags; remove '$arg'\n");
            return 1;
        }
    }

    $repo = rtrim($t->repoPath(), '/');
    $runId = gmdate('Ymd-His') . '-' . bin2hex(random_bytes(16));
    $duoDir = $repo . '/.duo';
    $artifact = "$duoDir/artifacts/promote-$runId.json";
    $checkpoint = "$duoDir/checkpoints/promote-$runId.sql";
    $mkdir = $t->captureRaw(
        'mkdir -p ' . escapeshellarg(dirname($artifact)) . ' ' . escapeshellarg(dirname($checkpoint))
    );
    if ($mkdir['exit'] !== 0) {
        fwrite(STDERR, "duo: promote: could not create target checkpoint directories\n");
        $detail = trim($mkdir['stderr'] !== '' ? $mkdir['stderr'] : $mkdir['stdout']);
        if ($detail !== '') {
            fwrite(STDERR, $detail . "\n");
        }
        return $mkdir['exit'] !== 0 ? $mkdir['exit'] : 1;
    }

    echo "promote phase: compile\n";
    $compile = $t->captureWp([
        'duo', 'compile', '--repo=' . $repo, '--out=' . $artifact, '--format=json',
    ]);
    if ($compile['exit'] !== 0) {
        fwrite(STDERR, "duo: promote: compile failed; no checkpoint or target mutation occurred\n");
        $detail = trim($compile['stderr'] !== '' ? $compile['stderr'] : $compile['stdout']);
        if ($detail !== '') {
            fwrite(STDERR, $detail . "\n");
        }
        return $compile['exit'] !== 0 ? $compile['exit'] : 1;
    }
    $compiledSummary = json_decode(trim($compile['stdout']), true);
    $artifactHash = is_array($compiledSummary) ? (string) ($compiledSummary['artifact_hash'] ?? '') : '';
    if (!preg_match('/^[a-f0-9]{64}$/', $artifactHash)) {
        fwrite(STDERR, "duo: promote: compile returned no valid artifact hash; no checkpoint or target mutation occurred\n");
        return 1;
    }

    echo "promote phase: checkpoint\n";
    $export = $t->captureWp(['db', 'export', $checkpoint, '--porcelain']);
    if ($export['exit'] !== 0) {
        fwrite(STDERR, "duo: promote: database checkpoint failed; deploy/apply were not started\n");
        $detail = trim($export['stderr'] !== '' ? $export['stderr'] : $export['stdout']);
        if ($detail !== '') {
            fwrite(STDERR, $detail . "\n");
        }
        return $export['exit'] !== 0 ? $export['exit'] : 1;
    }
    echo "database checkpoint: $checkpoint\n";

    $compiledFlag = '--compiled=' . $artifact;
    $promotionOwnerFlag = '--promotion-owner=' . $runId;
    $deployExtra = array_values(array_filter($extra, static function (string $arg): bool {
        return $arg === '--force-code-mismatch'
            || $arg === '--force-code-drift'
            || str_starts_with($arg, '--force-code-mismatch=')
            || str_starts_with($arg, '--force-code-drift=');
    }));

    echo "promote phase: deploy\n";
    $deploy = $t->streamWp(array_merge(
        ['duo', 'deploy', '--repo=' . $repo, $compiledFlag, $promotionOwnerFlag, '--promotion-hold'],
        $deployExtra
    ));
    if ($deploy !== 0) {
        return promote_failed($t, 'deploy', $deploy, $checkpoint);
    }

    echo "promote phase: apply\n";
    $apply = $t->streamWp(array_merge(
        ['duo', 'apply', '--repo=' . $repo, $compiledFlag, $promotionOwnerFlag],
        $extra
    ));
    if ($apply !== 0) {
        return promote_failed($t, 'apply', $apply, $checkpoint);
    }

    echo "promote complete: deploy -> apply\n";
    echo "database checkpoint retained: $checkpoint\n";
    return 0;
}

function promote_failed(Transport $t, string $phase, int $exit, string $checkpoint): int {
    fwrite(STDERR, "duo: promote: $phase failed (exit $exit); later phases were not run\n");
    fwrite(STDERR, "database checkpoint: $checkpoint\n");
    fwrite(STDERR, "restore with: " . $t->wpInstruction(['db', 'import', $checkpoint]) . "\n");
    return $exit !== 0 ? $exit : 1;
}

/**
 * Shared fetch+decode for `wp duo pending --format=json`, used by both
 * `duo pending` and `duo classify` (which triages the same queue). Mirrors
 * cmd_status()'s captureWp()-then-decode shape so a transport/parse failure
 * reports the same way `duo status` does, with the agent's own exit code
 * propagated rather than a generic 1.
 *
 * @return array{ok:bool, exit:int, items:list<array<string,mixed>>}
 */
function fetch_pending(Transport $t): array {
    $r = $t->captureWp(['duo', 'pending', '--repo=' . $t->repoPath(), '--format=json']);
    if ($r['exit'] !== 0) {
        fwrite(STDERR, "duo: pending: failed to fetch the review queue for '{$t->name()}' (exit {$r['exit']})\n");
        $msg = trim($r['stderr'] !== '' ? $r['stderr'] : $r['stdout']);
        if ($msg !== '') {
            fwrite(STDERR, $msg . "\n");
        }
        return ['ok' => false, 'exit' => $r['exit'] !== 0 ? $r['exit'] : 1, 'items' => []];
    }
    $items = json_decode(trim($r['stdout']), true);
    if (!is_array($items)) {
        fwrite(STDERR, "duo: pending: could not parse review-queue JSON for '{$t->name()}'\n");
        fwrite(STDERR, "raw output:\n{$r['stdout']}\n");
        return ['ok' => false, 'exit' => 1, 'items' => []];
    }
    return ['ok' => true, 'exit' => 0, 'items' => array_values($items)];
}

function cmd_pending(Transport $t, array $extra): int {
    if (in_array('--format=json', $extra, true)) {
        // Raw passthrough, same precedent as `duo status` vs. `duo plan
        // --format=json` (see cli/README.md): `duo pending` parses and
        // renders a table by default, but scripting/cross-checking wants
        // the agent's own JSON verbatim.
        return $t->streamWp(['duo', 'pending', '--repo=' . $t->repoPath(), '--format=json']);
    }
    if ($extra) {
        fwrite(STDERR, 'duo: pending: unknown flag(s): ' . implode(' ', $extra) . "\n");
        return 1;
    }
    $res = fetch_pending($t);
    if (!$res['ok']) {
        return $res['exit'];
    }
    if (!$res['items']) {
        echo "review queue is empty\n";
        return 0;
    }
    $summary = Pending::render($res['items']);
    foreach ($summary['lines'] as $line) {
        echo $line . "\n";
    }
    return 0;
}

/**
 * Batches triage decisions into the `--set` args for `wp duo classify`.
 *
 * CONFIRMED against the landed agent/src/Cli.php::classify() docblock
 * (task #12): wp-cli's assoc-arg parser keeps only the *last* occurrence of
 * a repeated `--set=<spec>` flag, so every decision must travel in ONE
 * semicolon-joined --set value — `--set 'post_meta:foo=runtime;options:bar=authored,ref=post'`
 * is the agent's own documented example. Left as a mode switch (rather than
 * hardcoding the join) purely so a future wp-cli/agent change is still a
 * one-line fix here.
 */
const CLASSIFY_SET_MODE = 'joined';

/** @param list<array{section:string,key:string,class:string,ref?:string}> $decisions */
function build_classify_args(array $decisions, bool $needAllowSecret): array {
    $specs = array_map(function (array $d): string {
        $spec = "{$d['section']}:{$d['key']}={$d['class']}";
        if (isset($d['ref'])) {
            $spec .= ",ref={$d['ref']}";
        }
        return $spec;
    }, $decisions);

    $args = CLASSIFY_SET_MODE === 'joined'
        ? ['--set=' . implode(';', $specs)]
        : array_map(fn(string $s) => '--set=' . $s, $specs);

    if ($needAllowSecret) {
        $args[] = '--allow-secret';
    }
    return $args;
}

function cmd_classify(Transport $t, array $extra): int {
    $unknown = array_values(array_diff($extra, ['--accept-proposals']));
    if ($unknown) {
        fwrite(STDERR, 'duo: classify: unknown flag(s): ' . implode(' ', $unknown) . "\n");
        return 1;
    }
    $acceptProposals = in_array('--accept-proposals', $extra, true);

    $res = fetch_pending($t);
    if (!$res['ok']) {
        return $res['exit'];
    }
    if (!$res['items']) {
        echo "review queue is empty\n";
        return 0;
    }

    return $acceptProposals
        ? cmd_classify_accept_proposals($t, $res['items'])
        : cmd_classify_interactive($t, $res['items']);
}

function cmd_classify_interactive(Transport $t, array $items): int {
    $result = Triage::run($items, STDIN, STDOUT);

    $exit = 0;
    if ($result['decisions']) {
        $args = build_classify_args($result['decisions'], $result['needAllowSecret']);
        $exit = $t->streamWp(array_merge(['duo', 'classify', '--repo=' . $t->repoPath()], $args));
    }
    printf("\n%d classified, %d skipped.\n", $result['classified'], $result['skipped']);
    return $exit;
}

/**
 * Non-interactive acceptance for CI/scripting. Triage::acceptProposals()
 * does the actual filtering (pure, unit-testable without a transport); this
 * just batches the result into one `wp duo classify` call, streams it, and
 * turns a non-empty secretSkipped into a non-zero exit so a CI pipeline can
 * tell "nothing to do" apart from "a human needs to look at this."
 */
function cmd_classify_accept_proposals(Transport $t, array $items): int {
    $result = Triage::acceptProposals($items);
    $decisions = $result['decisions'];
    $secretSkipped = $result['secretSkipped'];

    $exit = 0;
    if ($decisions) {
        $args = build_classify_args($decisions, false);
        $exit = $t->streamWp(array_merge(['duo', 'classify', '--repo=' . $t->repoPath()], $args));
    } else {
        echo "no proposals to accept\n";
    }

    if ($secretSkipped) {
        fwrite(STDERR, 'duo: classify --accept-proposals: skipped ' . count($secretSkipped)
            . " secret-flagged item(s) proposed authored -- these need a human (\`duo classify {$t->name()}\`):\n");
        foreach ($secretSkipped as $s) {
            fwrite(STDERR, "  - $s\n");
        }
        return $exit !== 0 ? $exit : 2;
    }

    if ($decisions) {
        printf("%d accepted.\n", count($decisions));
    }
    return $exit;
}

try {
    exit(main($argv));
} catch (\Throwable $e) {
    duo_fail($e->getMessage());
}
