    "stage": {"transport": "ssh", "host": "deploy@stage.example.com",
              "wp_path": "/var/www/html", "repo_path": "/srv/site"},
    "dev":   {"transport": "local", "wp_path": "/var/www/html",
              "repo_path": "/home/me/site"}
  }}

Both registry files are found by walking upward from the current directory,
git-style. The overlay (.duo-envs.json) replaces same-named entries from
site.duo.json entirely — no per-key merge. See cli/README.md for the full
contract, transport requirements, and the overlay convention.
TXT;
}

/** @return never */
function duo_fail(string $message, int $code = 1) {
    fwrite(STDERR, "duo: $message\n");
    exit($code);
}

function main(array $argv): int {
    array_shift($argv); // script path

    $envsFileOverride = null;
    $showHelp = false;
    $rest = [];
    foreach ($argv as $a) {
        if ($a === '-h' || $a === '--help') {
            $showHelp = true;
        } elseif (str_starts_with($a, '--envs-file=')) {
            $envsFileOverride = substr($a, strlen('--envs-file='));
        } else {
            $rest[] = $a;
        }
    }

    if ($showHelp) {
        echo duo_usage() . "\n";
        return 0;
    }
    if (count($rest) === 0) {
        echo duo_usage() . "\n";
        return 1;
    }

    $verb = array_shift($rest);
    $verbsNeedingEnv = ['doctor', 'adopt', 'status', 'capture', 'plan', 'apply', 'deploy', 'env-set', 'promote', 'pending', 'classify'];

    if ($verb === 'envs') {
        return cmd_envs($envsFileOverride);
    }

    if (!in_array($verb, $verbsNeedingEnv, true)) {
        fwrite(STDERR, "duo: unknown verb '$verb'\n\n" . duo_usage() . "\n");
        return 1;
    }
    if (count($rest) < 1) {
        duo_fail("'$verb' requires an <env> argument");
    }
    $envName = array_shift($rest);
    $extra = $rest;

    $envs = Registry::load($envsFileOverride, getcwd() ?: '.');
    $cfg = Registry::get($envs, $envName);
    $transport = Transport::make($envName, $cfg);

    return match ($verb) {
        'doctor' => cmd_doctor($transport),
        'adopt' => cmd_adopt($transport, $extra),
        'status' => cmd_status($transport),
        'capture', 'plan', 'apply', 'env-set' => cmd_passthrough($transport, $verb, $extra),
        'deploy' => cmd_deploy($transport, $extra),
        'promote' => cmd_promote($transport, $extra),
        'pending' => cmd_pending($transport, $extra),
        'classify' => cmd_classify($transport, $extra),
    };
}

function cmd_envs(?string $envsFileOverride): int {
    $envs = Registry::load($envsFileOverride, getcwd() ?: '.');
    if (!$envs) {
        fwrite(STDERR, "duo: no environments defined (looked for an 'envs' object in site.duo.json and .duo-envs.json)\n");
        return 1;
    }
    $width = max(array_map('strlen', array_keys($envs)));
    foreach ($envs as $name => $cfg) {
        try {
            $t = Transport::make($name, $cfg);
            printf("%-{$width}s  %s\n", $name, $t->describe());
        } catch (\Throwable $e) {
            printf("%-{$width}s  ERROR: %s\n", $name, $e->getMessage());
        }
    }
    return 0;
}

function cmd_doctor(Transport $t): int {
    $result = Doctor::run($t);
    foreach ($result['checks'] as $c) {
        // DUO-3231: an advisory check (DISALLOW_FILE_MODS today) never
        // fails the command (Doctor::run()'s own $ok fold already skips
        // it) — labeling a not-ok advisory row WARN rather than FAIL keeps
        // the printed severity honest about that, matching the issue's own
        // "reports its absence as a warning" language rather than implying
        // doctor considers the environment broken.
        $mark = $c['ok'] ? 'PASS' : (!empty($c['advisory']) ? 'WARN' : 'FAIL');
        $line = "[$mark] {$c['label']}";
        if (!$c['ok'] && $c['detail'] !== '') {
            $line .= " — {$c['detail']}";
        }
        echo $line . "\n";
    }
    return $result['ok'] ? 0 : 1;
}

function cmd_adopt(Transport $t, array $extra): int {
    if ($extra !== []) {
        fwrite(STDERR, "duo: adopt accepts no extra arguments\n");
        return 1;
    }
    if (!$t instanceof \Duo\Orchestrator\SshTransport) {
        fwrite(STDERR, "duo: adopt requires an ssh transport; local/docker environments already have a direct delivery path\n");
        return 1;
    }

    echo "adopt phase: preflight + staged install\n";
    $result = Adopt::install($t, dirname(__DIR__));
    if ($result['exit'] !== 0) {
        fwrite(STDERR, "duo: adopt failed during {$result['phase']}\n");
        print_transport_detail($result);
        return $result['exit'];
    }

    $repoAction = $result['repo_created'] ? 'created seed site.duo.json' : 'retained existing site.duo.json';
    echo "adopt: installed agent {$result['version']} + manifest library; $repoAction\n";
    echo "adopt phase: doctor\n";
    return cmd_doctor($t);
}

function cmd_status(Transport $t): int {
    $r = $t->captureWp(['duo', 'plan', '--repo=' . $t->repoPath(), '--format=json']);
    if ($r['exit'] !== 0) {
        fwrite(STDERR, "duo: status: failed to fetch plan for '{$t->name()}' (exit {$r['exit']})\n");
        $msg = trim($r['stderr'] !== '' ? $r['stderr'] : $r['stdout']);
        if ($msg !== '') {
            fwrite(STDERR, $msg . "\n");
        }
        return $r['exit'] !== 0 ? $r['exit'] : 1;
    }
    $plan = json_decode(trim($r['stdout']), true);
    if (!is_array($plan)) {
        fwrite(STDERR, "duo: status: could not parse plan JSON for '{$t->name()}'\n");
        fwrite(STDERR, "raw output:\n{$r['stdout']}\n");
        return 1;
    }
    $summary = PlanSummary::render($plan);
    foreach ($summary['lines'] as $line) {
        echo $line . "\n";
    }
    return $summary['ok'] ? 0 : 1;
}

function cmd_passthrough(Transport $t, string $verb, array $extra): int {
    $wpArgs = array_merge(['duo', $verb, '--repo=' . $t->repoPath()], $extra);
    return $t->streamWp($wpArgs);
}

/** One generated owner identifies every target-side phase of a host run. */
function orchestrator_run_id(): string {
    return gmdate('Ymd-His') . '-' . bin2hex(random_bytes(16));
}

/** Arguments only the orchestrator can truthfully own. */
function is_orchestrator_internal_flag(string $arg): bool {
    foreach (['--repo', '--compiled', '--artifact-hash', '--promotion-owner', '--promotion-hold', '--materializing-code', '--state-handoff'] as $flag) {
        if ($arg === $flag || str_starts_with($arg, $flag . '=')) {
            return true;
        }
    }
    return false;
}

/** Emit both distinct streams of a captured transport failure. */
function print_transport_detail(array $result): void {
    // Docker Compose writes container lifecycle chatter to stderr even when
    // the command itself returns its structured diagnostic on stdout.  A
    // stderr-wins choice hides the actual refusal in exactly that common
    // transport shape, so preserve both distinct streams.
    $seen = [];
    foreach ([$result['stderr'] ?? '', $result['stdout'] ?? ''] as $stream) {
        $detail = trim((string) $stream);
        if ($detail === '' || isset($seen[$detail])) {
            continue;
        }
        $seen[$detail] = true;
        fwrite(STDERR, $detail . "\n");
    }
}

/** @return list<string> force flags that may also be passed to lifecycle deploy. */
function deploy_force_flags(array $extra, string $verb): array {
    $allowed = [];
    foreach ($extra as $arg) {
        if (is_orchestrator_internal_flag($arg)) {
            throw new \RuntimeException(
                "$verb owns its repository, compiled artifact/hash, code-materialization, and target lease flags; remove '$arg'"
            );
        }
        if ($arg === '--force-code-mismatch' || $arg === '--force-code-drift'
            || str_starts_with($arg, '--force-code-mismatch=')
            || str_starts_with($arg, '--force-code-drift=')) {
            $allowed[] = $arg;
            continue;
        }
        throw new \RuntimeException(
            "duo $verb: unsupported deploy flag '$arg' (only --force-code-mismatch and --force-code-drift are accepted)"
        );
    }
    return $allowed;
}

/**
 * Host-level code deploy. Unlike promote it deliberately does not create a
 * database checkpoint: it owns only the immutable artifact plus the code
 * stage/lifecycle/finalize sequence. Operators who need the coupled DB
 * checkpoint use `duo promote`.
 */
function cmd_deploy(Transport $t, array $extra): int {
    try {
        $deployExtra = deploy_force_flags($extra, 'deploy');
    } catch (\Throwable $e) {
        fwrite(STDERR, 'duo: ' . $e->getMessage() . "\n");
        return 1;
    }

    $repo = rtrim($t->repoPath(), '/');
    $runId = orchestrator_run_id();
    $artifact = "$repo/.duo/artifacts/deploy-$runId.json";
    $mkdir = $t->captureRaw('mkdir -p ' . escapeshellarg(dirname($artifact)));
    if ($mkdir['exit'] !== 0) {
        fwrite(STDERR, "duo: deploy: could not create target artifact directory\n");
        print_transport_detail($mkdir);
        return $mkdir['exit'] !== 0 ? $mkdir['exit'] : 1;
    }

    echo "deploy phase: compile\n";
    $compile = CodeDeploy::compile($t, $repo, $artifact);
    if ($compile['exit'] !== 0) {
        fwrite(STDERR, "duo: deploy: compile failed; no lifecycle or code materialization occurred\n");
        print_transport_detail($compile);
        return $compile['exit'] !== 0 ? $compile['exit'] : 1;
    }
    if ($compile['summary'] === null) {
        fwrite(STDERR, "duo: deploy: compile returned no valid artifact hash; no lifecycle or code materialization occurred\n");
        return 1;
    }

    $artifactHash = (string) $compile['summary']['artifact_hash'];
    $codeEnabled = CodeDeploy::enabled($compile['summary']);
    echo "deploy phase: promotion-begin\n";
    $begin = $t->captureWp(CodeDeploy::beginArgs($runId, $artifactHash));
    if ($begin['exit'] !== 0) {
        fwrite(STDERR, "duo: deploy: promotion-begin failed; lifecycle and code materialization were not started\n");
        print_transport_detail($begin);
        compensate_uncertain_begin($t, $begin, $runId, $artifactHash, 'deploy');
        return $begin['exit'] !== 0 ? $begin['exit'] : 1;
    }

    if ($codeEnabled) {
        echo "deploy phase: code-stage\n";
        $stage = $t->streamWp(CodeDeploy::stageArgs($repo, $artifact, $runId, $artifactHash));
        if ($stage !== 0) {
            fwrite(STDERR, "duo: deploy: code-stage failed (exit $stage); lifecycle deploy and code-finalize were not run\n");
            promotion_abort($t, $runId, $artifactHash);
            return $stage;
        }
    }

    echo "deploy phase: lifecycle\n";
    $lifecycle = $t->streamWp(CodeDeploy::lifecycleArgs(
        $repo, $artifact, $runId, $artifactHash, $codeEnabled, $codeEnabled, false, $deployExtra
    ));
    if ($lifecycle !== 0) {
        fwrite(STDERR, "duo: deploy: lifecycle deploy failed (exit $lifecycle); later phases were not run\n");
        promotion_abort($t, $runId, $artifactHash);
        return $lifecycle;
    }

    if ($codeEnabled) {
        echo "deploy phase: code-finalize\n";
        $finalize = $t->streamWp(CodeDeploy::finalizeArgs($repo, $artifact, $runId, $artifactHash, false));
        if ($finalize !== 0) {
            fwrite(STDERR, "duo: deploy: code-finalize failed (exit $finalize); later phases were not run\n");
            promotion_abort($t, $runId, $artifactHash);
            return $finalize;
        }
        echo "deploy complete: code-stage -> lifecycle deploy -> code-finalize\n";
        return 0;
    }

    echo "deploy complete: lifecycle deploy (no code descriptor)\n";
    return 0;
}

/**
 * Promotion's fail-closed state machine. It first binds the target lease to
 * the compiled outer artifact, then takes the DB checkpoint under that lease.
 * It keeps the hook-firing lifecycle window distinct from apply's canary, now
 * with an optional code stage and finalize around that lifecycle phase. A
 * legacy artifact with no code descriptor follows the original deploy ->
 * apply path byte-for-byte after the checkpoint boundary.
 */
function cmd_promote(Transport $t, array $extra): int {
    foreach ($extra as $arg) {
        if (is_orchestrator_internal_flag($arg)) {
            fwrite(STDERR, "duo: promote owns its repository, compiled artifact/hash, code-materialization, and target lease flags; remove '$arg'\n");
            return 1;
        }
    }

    $repo = rtrim($t->repoPath(), '/');
    $runId = orchestrator_run_id();
    $duoDir = $repo . '/.duo';
    $artifact = "$duoDir/artifacts/promote-$runId.json";
    $checkpoint = "$duoDir/checkpoints/promote-$runId.sql";
    $mkdir = $t->captureRaw(
        'mkdir -p ' . escapeshellarg(dirname($artifact)) . ' ' . escapeshellarg(dirname($checkpoint))
    );
    if ($mkdir['exit'] !== 0) {
        fwrite(STDERR, "duo: promote: could not create target checkpoint directories\n");
        print_transport_detail($mkdir);
        return $mkdir['exit'] !== 0 ? $mkdir['exit'] : 1;
    }

    echo "promote phase: compile\n";
    $compile = CodeDeploy::compile($t, $repo, $artifact);
    if ($compile['exit'] !== 0) {
        fwrite(STDERR, "duo: promote: compile failed; no checkpoint or target mutation occurred\n");
        print_transport_detail($compile);
        return $compile['exit'] !== 0 ? $compile['exit'] : 1;
    }
    if ($compile['summary'] === null) {
        fwrite(STDERR, "duo: promote: compile returned no valid artifact hash; no checkpoint or target mutation occurred\n");
        return 1;
    }
    $artifactHash = (string) $compile['summary']['artifact_hash'];
    $codeEnabled = CodeDeploy::enabled($compile['summary']);

    echo "promote phase: promotion-begin\n";
    $begin = $t->captureWp(CodeDeploy::beginArgs($runId, $artifactHash));
    if ($begin['exit'] !== 0) {
        fwrite(STDERR, "duo: promote: promotion-begin failed; checkpoint, deploy, and apply were not started\n");
        print_transport_detail($begin);
        compensate_uncertain_begin($t, $begin, $runId, $artifactHash, 'promote');
        return $begin['exit'] !== 0 ? $begin['exit'] : 1;
    }

    echo "promote phase: checkpoint\n";
    $export = $t->captureWp(['db', 'export', $checkpoint, '--porcelain']);
    if ($export['exit'] !== 0) {
        fwrite(STDERR, "duo: promote: database checkpoint failed; deploy/apply were not started\n");
        print_transport_detail($export);
        $clean = promotion_abort($t, $runId, $artifactHash);
        if ($clean) {
            fwrite(STDERR, "duo: promote: promotion lease cleanup confirmed; no usable checkpoint was produced\n");
        }
        return $export['exit'] !== 0 ? $export['exit'] : 1;
    }
    echo "database checkpoint: $checkpoint\n";

    $deployExtra = array_values(array_filter($extra, static function (string $arg): bool {
        return $arg === '--force-code-mismatch'
            || $arg === '--force-code-drift'
            || $arg === '--force-unresolved-refs'
            || str_starts_with($arg, '--force-code-mismatch=')
            || str_starts_with($arg, '--force-code-drift=')
            || str_starts_with($arg, '--force-unresolved-refs=');
    }));

    if ($codeEnabled) {
        echo "promote phase: code-stage\n";
        $stage = $t->streamWp(CodeDeploy::stageArgs($repo, $artifact, $runId, $artifactHash));
        if ($stage !== 0) {
            return promote_failed($t, 'code-stage', $stage, $checkpoint, true, $runId, $artifactHash);
        }
    }

    echo "promote phase: deploy\n";
    $deploy = $t->streamWp(CodeDeploy::lifecycleArgs(
        $repo, $artifact, $runId, $artifactHash, true, $codeEnabled, true, $deployExtra
    ));
    if ($deploy !== 0) {
        return promote_failed($t, 'deploy', $deploy, $checkpoint, $codeEnabled, $runId, $artifactHash);
    }

    if ($codeEnabled) {
        echo "promote phase: code-finalize\n";
        $finalize = $t->streamWp(CodeDeploy::finalizeArgs($repo, $artifact, $runId, $artifactHash, true));
        if ($finalize !== 0) {
            return promote_failed($t, 'code-finalize', $finalize, $checkpoint, true, $runId, $artifactHash);
        }
    }

    echo "promote phase: apply\n";
    $apply = $t->streamWp(array_merge(
        [
            'duo', 'apply', '--repo=' . $repo, '--compiled=' . $artifact,
            '--promotion-owner=' . $runId, '--artifact-hash=' . $artifactHash,
        ],
        $extra
    ));
    if ($apply !== 0) {
        return promote_failed($t, 'apply', $apply, $checkpoint, $codeEnabled, $runId, $artifactHash);
    }

    echo $codeEnabled
        ? "promote complete: code-stage -> deploy -> code-finalize -> apply\n"
        : "promote complete: deploy -> apply\n";
    echo "database checkpoint retained: $checkpoint\n";
    return 0;
}

/**
 * Best-effort host compensation after any post-begin failure. The agent's
 * mutating phases release on their own failures too, so success here includes
 * a matching lease that is already absent. A mismatching owner/hash remains a
 * hard warning: never erase another promotion's lock to make this run look
 * clean.
 */
function promotion_abort(Transport $t, string $owner, string $artifactHash): bool {
    $abort = $t->captureWp(CodeDeploy::abortArgs($owner, $artifactHash));
    if ($abort['exit'] === 0) {
        return true;
    }
    fwrite(STDERR, "duo: promote: promotion lease cleanup could not be confirmed\n");
    print_transport_detail($abort);
    fwrite(STDERR, "retry lease cleanup with: " . $t->wpInstruction(CodeDeploy::abortArgs($owner, $artifactHash)) . "\n");
    return false;
}

/** Compensate only an ambiguous begin; a named live contender is definitive. */
function compensate_uncertain_begin(
    Transport $t,
    array $begin,
    string $owner,
    string $artifactHash,
    string $verb
): void {
    $detail = (string) ($begin['stdout'] ?? '') . "\n" . (string) ($begin['stderr'] ?? '');
    if (str_contains($detail, 'promotion lock held by')) {
        fwrite(STDERR, "duo: $verb: target reported a definite competing lease; no cleanup was attempted\n");
        return;
    }
    fwrite(STDERR, "duo: $verb: begin outcome is uncertain; attempting exact owner/artifact cleanup\n");
    promotion_abort($t, $owner, $artifactHash);
}

/** Print row repair for a dump containing its lease; external exclusion is required. */
function print_promotion_recovery(
    Transport $t,
    string $checkpoint,
    bool $codeMayHaveChanged,
    string $owner,
    string $artifactHash
): void {
    fwrite(STDERR, "database checkpoint: $checkpoint\n");
    if ($codeMayHaveChanged) {
        fwrite(
            STDERR,
            "duo: promote: code may be staged or partially finalized; first reconcile or restore code to a known pre-promotion revision.\n"
        );
    }
    fwrite(
        STDERR,
        "duo: promote: this checkpoint contains its temporary promotion lease row. "
        . "A database import can replace that row, so first establish external maintenance/exclusion "
        . "that prevents every Duo writer for the full recovery window. The commands below repair the row; "
        . "they are not a substitute for that exclusion. Then run in this order:\n"
    );
    fwrite(STDERR, "  1. " . $t->wpInstruction(CodeDeploy::abortArgs($owner, $artifactHash)) . "\n");
    fwrite(STDERR, "  2. " . $t->wpInstruction(CodeDeploy::beginArgs($owner, $artifactHash)) . "\n");
    fwrite(STDERR, "  3. " . $t->wpInstruction(['db', 'import', $checkpoint]) . "\n");
    fwrite(STDERR, "  4. " . $t->wpInstruction(CodeDeploy::abortArgs($owner, $artifactHash)) . "\n");
    fwrite(STDERR, "duo: promote: run step 4 even if the database import fails.\n");
}

function promote_failed(
    Transport $t,
    string $phase,
    int $exit,
    string $checkpoint,
    bool $codeMayHaveChanged,
    string $owner,
    string $artifactHash
): int {
    fwrite(STDERR, "duo: promote: $phase failed (exit $exit); later phases were not run\n");
    if (promotion_abort($t, $owner, $artifactHash)) {
        fwrite(STDERR, "duo: promote: promotion lease cleanup confirmed\n");
        print_promotion_recovery($t, $checkpoint, $codeMayHaveChanged, $owner, $artifactHash);
    } else {
        fwrite(STDERR, "duo: promote: do not begin checkpoint recovery until the exact lease cleanup command above succeeds. Expiry lets a different promotion owner recover the target; it does not authorize this checkpoint restore.\n");
    }
    return $exit !== 0 ? $exit : 1;
}

/**
 * Shared fetch+decode for `wp duo pending --format=json`, used by both
 * `duo pending` and `duo classify` (which triages the same queue). Mirrors
 * cmd_status()'s captureWp()-then-decode shape so a transport/parse failure
 * reports the same way `duo status` does, with the agent's own exit code
 * propagated rather than a generic 1.
 *
 * @return array{ok:bool, exit:int, items:list<array<string,mixed>>}
 */
function fetch_pending(Transport $t): array {
    $r = $t->captureWp(['duo', 'pending', '--repo=' . $t->repoPath(), '--format=json']);
    if ($r['exit'] !== 0) {
        fwrite(STDERR, "duo: pending: failed to fetch the review queue for '{$t->name()}' (exit {$r['exit']})\n");
        $msg = trim($r['stderr'] !== '' ? $r['stderr'] : $r['stdout']);
        if ($msg !== '') {
            fwrite(STDERR, $msg . "\n");
        }
        return ['ok' => false, 'exit' => $r['exit'] !== 0 ? $r['exit'] : 1, 'items' => []];
    }
    $items = json_decode(trim($r['stdout']), true);
    if (!is_array($items)) {
        fwrite(STDERR, "duo: pending: could not parse review-queue JSON for '{$t->name()}'\n");
        fwrite(STDERR, "raw output:\n{$r['stdout']}\n");
        return ['ok' => false, 'exit' => 1, 'items' => []];
    }
    return ['ok' => true, 'exit' => 0, 'items' => array_values($items)];
}

function cmd_pending(Transport $t, array $extra): int {
    if (in_array('--format=json', $extra, true)) {
        // Raw passthrough, same precedent as `duo status` vs. `duo plan
        // --format=json` (see cli/README.md): `duo pending` parses and
        // renders a table by default, but scripting/cross-checking wants
        // the agent's own JSON verbatim.
        return $t->streamWp(['duo', 'pending', '--repo=' . $t->repoPath(), '--format=json']);
    }
    if ($extra) {
        fwrite(STDERR, 'duo: pending: unknown flag(s): ' . implode(' ', $extra) . "\n");
        return 1;
    }
    $res = fetch_pending($t);
    if (!$res['ok']) {
        return $res['exit'];
    }
    if (!$res['items']) {
        echo "review queue is empty\n";
        return 0;
    }
    $summary = Pending::render($res['items']);
    foreach ($summary['lines'] as $line) {
        echo $line . "\n";
    }
    return 0;
}

/**
 * Batches triage decisions into the `--set` args for `wp duo classify`.
 *
 * CONFIRMED against the landed agent/src/Cli.php::classify() docblock
 * (task #12): wp-cli's assoc-arg parser keeps only the *last* occurrence of
 * a repeated `--set=<spec>` flag, so every decision must travel in ONE
 * semicolon-joined --set value — `--set 'post_meta:foo=runtime;options:bar=authored,ref=post'`
 * is the agent's own documented example. Left as a mode switch (rather than
 * hardcoding the join) purely so a future wp-cli/agent change is still a
 * one-line fix here.
 */
const CLASSIFY_SET_MODE = 'joined';

/** @param list<array{section:string,key:string,class:string,ref?:string}> $decisions */
function build_classify_args(array $decisions, bool $needAllowSecret): array {
    $specs = array_map(function (array $d): string {
        $spec = "{$d['section']}:{$d['key']}={$d['class']}";
        if (isset($d['ref'])) {
            $spec .= ",ref={$d['ref']}";
        }
        return $spec;
    }, $decisions);

    $args = CLASSIFY_SET_MODE === 'joined'
        ? ['--set=' . implode(';', $specs)]
        : array_map(fn(string $s) => '--set=' . $s, $specs);

    if ($needAllowSecret) {
        $args[] = '--allow-secret';
    }
    return $args;
}

function cmd_classify(Transport $t, array $extra): int {
    $unknown = array_values(array_diff($extra, ['--accept-proposals']));
    if ($unknown) {
        fwrite(STDERR, 'duo: classify: unknown flag(s): ' . implode(' ', $unknown) . "\n");
        return 1;
    }
    $acceptProposals = in_array('--accept-proposals', $extra, true);

    $res = fetch_pending($t);
    if (!$res['ok']) {
        return $res['exit'];
    }
    if (!$res['items']) {
        echo "review queue is empty\n";
        return 0;
    }

    return $acceptProposals
        ? cmd_classify_accept_proposals($t, $res['items'])
        : cmd_classify_interactive($t, $res['items']);
}

function cmd_classify_interactive(Transport $t, array $items): int {
    $result = Triage::run($items, STDIN, STDOUT);

    $exit = 0;
    if ($result['decisions']) {
        $args = build_classify_args($result['decisions'], $result['needAllowSecret']);
        $exit = $t->streamWp(array_merge(['duo', 'classify', '--repo=' . $t->repoPath()], $args));
    }
    printf("\n%d classified, %d skipped.\n", $result['classified'], $result['skipped']);
    return $exit;
}

/**
 * Non-interactive acceptance for CI/scripting. Triage::acceptProposals()
 * does the actual filtering (pure, unit-testable without a transport); this
 * just batches the result into one `wp duo classify` call, streams it, and
 * turns a non-empty secretSkipped into a non-zero exit so a CI pipeline can
 * tell "nothing to do" apart from "a human needs to look at this."
 */
function cmd_classify_accept_proposals(Transport $t, array $items): int {
    $result = Triage::acceptProposals($items);
    $decisions = $result['decisions'];
    $secretSkipped = $result['secretSkipped'];

    $exit = 0;
    if ($decisions) {
        $args = build_classify_args($decisions, false);
        $exit = $t->streamWp(array_merge(['duo', 'classify', '--repo=' . $t->repoPath()], $args));
    } else {
        echo "no proposals to accept\n";
    }

    if ($secretSkipped) {
        fwrite(STDERR, 'duo: classify --accept-proposals: skipped ' . count($secretSkipped)
            . " secret-flagged item(s) proposed authored -- these need a human (\`duo classify {$t->name()}\`):\n");
        foreach ($secretSkipped as $s) {
            fwrite(STDERR, "  - $s\n");
        }
        return $exit !== 0 ? $exit : 2;
    }

    if ($decisions) {
        printf("%d accepted.\n", count($decisions));
    }
    return $exit;
}

try {
    exit(main($argv));
} catch (\Throwable $e) {
    duo_fail($e->getMessage());
}
