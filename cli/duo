#!/usr/bin/env php
<?php
declare(strict_types=1);

require_once __DIR__ . '/src/Application/ConsoleApplication.php';

use Duo\Orchestrator\EnvironmentCommand;
use Duo\Orchestrator\EnvironmentDriver;

function main(array $argv): int {
    return \Duo\Orchestrator\ConsoleApplication::run($argv);
}

/** Public nested environment lifecycle namespace compatibility facade. */
function cmd_environment(array $args, ?string $envsFileOverride): int {
    return EnvironmentCommand::run(
        $args,
        $envsFileOverride,
        static fn(EnvironmentDriver $driver, array $context): array|int => cmd_promote_frozen($driver, $context)
    );
}

// Compatibility anchors retained for source-level contract checks while the
// legacy handlers move behind the application registry:
// `duo env-set <env>`, [A-Za-z0-9][A-Za-z0-9._-]{0,63}
// return RefreshCommand::run($t, $extra);
// return RebaseCommand::run($t, $extra);
// 'status' => cmd_status($transport, $extra, $envsFileOverride)
// cmd_status($driver, [], $envsFileOverride)
// 'scope' => cmd_scope($transport, $extra), function cmd_scope(
// ScopeCommand::run($t, $extra), EnvironmentCommandPreflight::requiresEnvironment(
// EnvironmentCommandPreflight::capabilityReport(

// The source-level compatibility loader used by older offline fixtures evals
// this file without executing it. The executable guard remains the only
// runtime work performed by the public entrypoint.
$duoExecutablePath = str_replace('\\', '/', (string) ($argv[0] ?? ''));
$duoExecutableInvocation = basename($duoExecutablePath) === 'duo'
    || str_ends_with($duoExecutablePath, '/cli/duo');
if (!$duoExecutableInvocation) {
    return;
}

try {
    exit(main($argv));
} catch (\Throwable $exception) {
    fwrite(STDERR, 'duo: ' . $exception->getMessage() . "\n");
    exit(1);
}
