.DS_Store
*.log
sandbox/siterepo/
sandbox/tmp/

# DUO-3277: pair.sh writes this so docker compose auto-loads
# DUO_AGENT_SRC/DUO_MANIFESTS_SRC (resolved against THIS checkout's own
# canonical root) for any subsequent compose call made by any script from
# sandbox/ — never committed, since the paths it holds are host- and
# checkout-specific.
sandbox/.env
.duo-envs.json
.duo/
.claude/worktrees/

# DUO-3213: capture's staging/backup/lock and durable protocol artifacts
# (agent/src/Publish.php)
# — siblings of any published state dir; git must never see one, even
# transiently mid-capture or during recovery.
state.capture-staging/
state.capture-backup/
state.capture-intent
state.capture-receipt
state.capture-intent.tmp.*
state.capture-receipt.tmp.*
state.capture.lock

# DUO-3232: see sandbox/site-repo.gitignore.template's own note — belt-and-
# suspenders for local testing/experimentation against this repo's own
# root, mirroring .duo-envs.json's identical treatment above. The real,
# load-bearing copy of this ignore rule is the template, which becomes
# every managed site-repo's OWN .gitignore.
.duo-env-values.json

# DUO-3223 (version-boundary matrix / artifact-sourcing ruling, issue
# comment 0ec1d2e3): the content-addressed cache sandbox/bin/fetch-
# artifact.sh downloads pinned plugin ZIPs into. sandbox/conformance/
# artifacts.lock.json (the pins themselves — {slug, version, url, sha256})
# IS committed; the ZIPs it verifies are exactly the kind of large,
# regenerable-from-a-pinned-digest binary blob git should never carry.
sandbox/conformance/artifacts-cache/*
!sandbox/conformance/artifacts-cache/.gitkeep

# DUO-3223: generated content-addressed certification bundles. The schema,
# builder, verifier, and reference harness are committed; each run's logs and
# environment evidence are immutable outputs published by digest, not source.
sandbox/certification-bundles/
