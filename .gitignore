.DS_Store
*.log
sandbox/siterepo/
sandbox/tmp/

# issue #3277: pair.sh writes this so docker compose auto-loads
# WPRISM_AGENT_SRC/WPRISM_ADAPTER_PACKAGES_SRC/WPRISM_PLATFORM_SRC (resolved
# against THIS checkout's own canonical root) for subsequent compose calls from
# sandbox/ — never committed, since the paths it holds are host- and
# checkout-specific.
sandbox/.env
/.wprism-envs.json
/.wprism/
.claude/worktrees/

# issue #3213: capture's staging/backup/lock and durable protocol artifacts
# (agent/src/Publication/Publish.php)
# — siblings of any published state dir; git must never see one, even
# transiently mid-capture or during recovery.
/state.capture-staging/
/state.capture-backup/
/state.capture-intent
/state.capture-receipt
/state.capture-intent.tmp.*
/state.capture-receipt.tmp.*
/state.capture-intent.previous
/state.capture-intent.next
/state.capture-receipt.previous
/state.capture-receipt.next
/state.capture.lock
/.wprism-init-code-*
/.wprism-init-attempt
/.wprism-init-attempt.next
/.*.wprism-init-*

# issue #3232: see sandbox/site-repo.gitignore.template's own note — belt-and-
# suspenders for local testing against this repo's own root, mirroring
# .wprism-envs.json's identical treatment above. The real,
# load-bearing copy of this ignore rule is the template, which becomes
# every managed site-repo's OWN .gitignore.
/.wprism-env-values.json

# issue #3223 (version-boundary matrix / artifact-sourcing ruling, issue
# comment 0ec1d2e3): the content-addressed cache sandbox/bin/fetch-
# artifact.sh downloads pinned plugin ZIPs into. Package-owned
# evidence/artifacts.lock.json fragments (the pins themselves) ARE committed;
# the ZIPs they verify are exactly the kind of large,
# regenerable-from-a-pinned-digest binary blob git should never carry.
sandbox/conformance/artifacts-cache/*
!sandbox/conformance/artifacts-cache/.gitkeep

# issue #3223: generated content-addressed certification bundles. The schema,
# builder, verifier, and reference harness are committed; each run's logs and
# environment evidence are immutable outputs published by digest, not source.
sandbox/certification-bundles/

# WPRISM WP-4: the repo-root dev toolchain (composer.json / phpstan.neon.dist /
# .php-cs-fixer.dist.php / phpunit.xml.dist) is structurally unshippable —
# cli/src/Onboarding/Adopt.php embeds the assembled adapter library in agent/
# and tars exactly `agent recovery`, so none of this can reach a managed site.
# What follows is the toolchain's *machine-local*
# output: installed vendor code and analyser caches. composer.lock is NOT
# ignored — it is the pinned, reproducible input every developer must
# resolve identically, and tests/Tooling asserts the drop-in itself
# never references vendor/autoload.php.
/vendor/
/.phpstan/
/.php-cs-fixer.cache
/.phpunit.cache
/.phpunit.result.cache
