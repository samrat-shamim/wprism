# DUO-3213: capture's staging/backup/lock artifacts (agent/src/Publish.php)
# — siblings of any published state dir (state.capture-staging, state.
# capture-backup, state.capture.lock); git must never see one, even
# transiently mid-capture.
state.capture-staging/
state.capture-backup/
state.capture.lock

# DUO-3232: see sandbox/site-repo.gitignore.template's own note — belt-and-
# suspenders for local testing/experimentation against this repo's own
# root, mirroring .duo-envs.json's identical treatment above. The real,
# load-bearing copy of this ignore rule is the template, which becomes
# every managed site-repo's OWN .gitignore.
.duo-env-values.json
