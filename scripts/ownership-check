#!/usr/bin/env php
<?php
declare(strict_types=1);

$root = dirname(__DIR__);
$ledgerPath = $root . '/docs/proposals/refactor-ownership.json';
$refresh = in_array('--refresh', array_slice($argv, 1), true);

function ownership_fail(string $message): never {
    fwrite(STDERR, "ownership-check: $message\n");
    exit(1);
}

/** @return list<string> */
function tracked_files(string $root): array {
    $process = proc_open(
        ['git', 'ls-files', '-z'],
        [0 => ['pipe','r'], 1 => ['pipe','w'], 2 => ['pipe','w']],
        $pipes,
        $root,
        null,
        ['bypass_shell' => true]
    );
    if (!is_resource($process)) ownership_fail('cannot enumerate tracked files');
    fclose($pipes[0]);
    $stdout = (string) stream_get_contents($pipes[1]);
    $stderr = (string) stream_get_contents($pipes[2]);
    fclose($pipes[1]); fclose($pipes[2]);
    if (proc_close($process) !== 0) ownership_fail('git ls-files failed: ' . trim($stderr));
    $files = array_values(array_filter(explode("\0", $stdout), static fn(string $v): bool => $v !== ''));
    sort($files, SORT_STRING);
    return $files;
}

