/** @return list<array{prefix:string,owner:string}> */
function new_prefix_assignments(): array {
    return [
        ['prefix'=>'agent/src/Agent/','owner'=>'thread-3'],['prefix'=>'agent/src/Capture/','owner'=>'thread-3'],
        ['prefix'=>'agent/src/Repository/','owner'=>'thread-3'],['prefix'=>'agent/src/WordPress/','owner'=>'thread-3'],
        ['prefix'=>'agent/src/Capability/','owner'=>'thread-4'],['prefix'=>'agent/src/Policy/','owner'=>'thread-4'],
        ['prefix'=>'agent/src/Adapter/','owner'=>'thread-4'],['prefix'=>'agent/src/Provider/','owner'=>'thread-4'],
        ['prefix'=>'agent/src/Evidence/','owner'=>'thread-4'],['prefix'=>'agent/src/Mutation/','owner'=>'thread-5'],
        ['prefix'=>'agent/src/Promotion/','owner'=>'thread-5'],['prefix'=>'agent/src/Lifecycle/','owner'=>'thread-5'],
        ['prefix'=>'cli/src/Application/','owner'=>'thread-2'],['prefix'=>'cli/src/Environment/','owner'=>'thread-2'],
        ['prefix'=>'cli/src/Transport/','owner'=>'thread-2'],['prefix'=>'cli/src/Refresh/','owner'=>'thread-2'],
