    "notes": {
        "src/Apply/TypedTableMaterializer.php": "Engine with the rest of the *Materializer family, for the same reason as TypedTableCapture.",
        "src/Capture/TypedTableCapture.php": "Engine with the rest of the *Capture family even though it only reads kernel files; the recorded Snapshot -> TypedTableCapture edge names the real seam (a repository state model driving engine capture) instead of hiding it behind a convenient placement.",
        "src/Code/CodeMaterializer.php": "Repository, not engine, despite the *Materializer suffix: it depends only on PathSafety and is used solely by Code. The engine *Materializer family materializes authored state; this one materializes code bytes for the repository half.",
        "src/Code/CodeOwnershipPruner.php": "Repository for the same reason as CodeMaterializer: a Code-owned pruner over PathSafety, not an engine apply step.",
        "src/Code/CodeStageTransaction.php": "Repository: a Code-owned Db/Ledger transaction, kept with Code so the code half stays internally consistent.",
        "src/Command/Cli.php": "The only surface file. It is the top of the ladder and may reference anything.",
        "src/Grammar/Blocks.php": "Policy, not kernel: block markup rewriting is driven by Policy and Tokens. Kept in one layer with Tokens/Shortcodes so the codec cycle resolves inside a layer instead of across two.",
        "src/Grammar/ShortcodeAlternateRegistrar.php": "Policy with Tokens/Shortcodes: it registers policy-declared shortcode alternates.",
        "src/Grammar/Shortcodes.php": "Policy with Tokens/Blocks, for the same reason as Blocks.",
        "src/Grammar/Tokens.php": "Policy, not kernel, although the four codecs it composes (TextTokenizer, IdentityTokenCodec, StructuredReferenceCodec, UrlQueryReferenceCodec) are kernel: Tokens itself reads Policy to decide what a reference means. Its read of Ledger is the recorded inversion.",
        "src/Kernel/Canon.php": "Kernel by doctrine (canonical JSON/ordering is a primitive). Its single read of Policy is the oldest recorded inversion in the graph and the highest-value one to retire.",
        "src/Kernel/DurableFilesystem.php": "Kernel by doctrine. Its two upward edges to Publish/PublicationJournal are an artefact of the guarded InitialStateBoundaryException class being declared in three files; the scanner attributes a reference to every declaring file. Recorded rather than hidden, because collapsing that triple declaration is the real fix.",
        "src/Kernel/OptionState.php": "Kernel: it depends on Canon alone and is read by 26 files across every layer, including policy grammars. Placing it any higher would invert the *Grammar reads without describing anything true.",
        "src/Kernel/ReferenceKeyspaceGrammar.php": "Kernel with the rest of the reference grammar: it depends only on ReferenceRules, and the policy loader that reads it sits above.",
        "src/Kernel/ReferenceKindGrammar.php": "Kernel: a dependency-free reference vocabulary.",
        "src/Kernel/ReferenceScopeClassifier.php": "Kernel: a dependency-free classifier read by Tokens, Shortcodes, Blocks and Capture.",
        "src/Kernel/ReferenceShapeGrammar.php": "Kernel with the rest of the reference grammar (ReferenceRules only).",
        "src/Kernel/TableGraph.php": "Kernel: a dependency-free table dependency graph.",
        "src/Kernel/TableSchema.php": "Kernel: depends on TableGraph alone.",
        "src/Kernel/UserMetaState.php": "Kernel: a dependency-free state model, read from the repository and engine layers.",
        "src/Policy/ArtifactPolicyIdentity.php": "Policy, not adapter: it is the identity a policy load stamps onto a compiled artifact. Its two reads of AdapterSources/CapabilityRegistry are the recorded inversion, not a reason to promote the file.",
        "src/Policy/CodeConfigGrammar.php": "Policy (the *Grammar axis) although it validates a Code envelope: its caller is SitePolicyValidator/Policy. The resulting read of Code is recorded rather than resolved by moving the grammar into the repository layer.",
        "src/Policy/DeletionCapabilityResolver.php": "Policy (the *Resolver axis), not the Deletion* engine family: it answers a policy question from OptionNameReferenceResolver and is read by Policy itself.",
        "src/Repository/CanonicalSurfaces.php": "Repository: a catalogue over OptionState and SidebarState, so it sits with the state models it enumerates rather than with the planners that consume it.",
        "src/Repository/Identity.php": "Repository: identity is repository-side truth (Uuid + SidebarState + Canon), not an engine operation.",
        "src/Repository/IdentityBackup.php": "Repository with the rest of the Identity* family. It reads only policy/repository/kernel files, so the placement costs nothing.",
        "src/Repository/ReferenceGraph.php": "Repository, unlike the Reference* grammar/rules/path files: it is a graph over Snapshot and SidebarState, i.e. compiled repository state.",
        "src/Repository/RepositoryDeletionParser.php": "Repository with the Repository* family. Its read of the engine Deletion model is a real inversion and is recorded: the parser should take a deletion shape, not the engine type.",
        "src/Repository/SidebarState.php": "Repository: a state model over Ledger/Snapshot/Db, the same axis as Snapshot and OptionState consumers.",
        "src/Repository/StateTreeWalker.php": "Repository: a dependency-free walker over compiled state trees, read by Lint."
    }
}
