{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://duo.local/contracts/test-selection.schema.json",
    "title": "Duo test selection",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "format", "selector_version", "authority", "state", "reason",
        "base_sha", "head_sha", "merge_base_sha", "catalog_sha256",
        "changed_paths", "changed_paths_sha256", "selected_suite_ids"
    ],
    "properties": {
        "format": {"const": "duo-test-selection/v1"},
        "selector_version": {"enum": ["changed-paths/v1", "explicit-diagnostic/v1"]},
        "authority": {"enum": ["advisory", "diagnostic"]},
        "state": {"enum": ["selected", "not_applicable"]},
        "reason": {"type": "string", "minLength": 1},
        "base_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
        "head_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
        "merge_base_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
        "catalog_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "changed_paths": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[^/\\x00][^\\x00]*$"},
            "uniqueItems": true
        },
        "changed_paths_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "selected_suite_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
            "uniqueItems": true
        }
    }
}
