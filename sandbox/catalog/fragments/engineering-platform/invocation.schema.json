{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duo.invalid/contracts/test-invocation/v1",
  "title": "Duo test invocation plan",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id", "argv", "timeout_seconds", "workspace_mode", "temporary_directory",
      "environment_class", "required_tools", "required_services", "resource_locks",
      "expected_outputs"
    ],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
      "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
      "workspace_mode": {"enum": ["read_only", "isolated_copy", "exclusive"]},
      "temporary_directory": {"enum": ["none", "unique", "suite_managed"]},
      "environment_class": {"enum": ["offline", "live", "destructive", "credentialed", "evidence-producing"]},
      "required_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "required_services": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "resource_locks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "expected_outputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^artifacts/"}}
    }
  }
}
