  "legacy_widget_boundary": {
    "block": "core/legacy-widget",
    "attributes": ["id", "idBase", "instance"],
    "stored_id_form": {
      "id_shape": "<idBase>-<positive-instance>",
      "storage": ["sidebars_widgets", "widget_<idBase>"],
      "identity": "SidebarState widget ledger"
    },
    "embedded_form": {
      "id_bases": ["tribe-widget-events-list", "tribe-widget-events-qr-code"],
      "encoded": "base64(PHP-serialized-instance)",
      "hash": "wp_hash(serialized-instance)",
      "target_rebinding_required": true
    },
    "callbacks": {
      "rest_pre_dispatch": "enable_widget_copy_paste",
      "rest_dispatch_request": "enable_saving_widget_copied",
      "render_block_data": "enable_rendering_widget_copied"
    },
    "version_delta": {
      "6.17.2": "decodes and re-signs without recursive object refusal",
      "6.17.3": "unserializes with allowed_classes=false and rejects nested objects before re-signing"
    },
    "duo_status": {
      "portable": false,
      "reason": "The shipped core block grammar still refuses id, idBase, and instance; production readiness requires a bounded TEC widget codec that validates plain decoded settings, rebases SidebarState IDs and event references, and re-signs with the target salt."
    }
  },
