{
  "name": "duo-taxonomy-keyspace-fixture",
  "plugin": "duo-taxonomy-keyspace/duo-taxonomy-keyspace.php",
  "post_types": {
    "dks_article": {"class": "authored"}
  },
  "spec_version": 2,
  "taxonomies": {
    "dks_post_rel": {
      "class": "authored",
      "object_keyspace": "post"
    },
    "dks_term_rel": {
      "class": "authored",
      "description_refs": {
        "json_refs": [
          {"kind": "post", "path": "$.links.*.post_id"},
          {"kind": "term", "path": "$.links.*.term_id"}
        ],
        "key_refs": {"kind": "term", "path": "$.by_term"}
      },
      "object_keyspace": "term"
    }
  },
  "version_range": {"max": "2.0.0", "min": "1.0.0"}
}
